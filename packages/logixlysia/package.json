{
  "name": "logixlysia",
  "version": "6.6.0",
  "description": "🦊 Logixlysia is a logger for Elysia",
  "keywords": [
    "logixlysia",
    "elysiajs",
    "logger"
  ],
  "homepage": "https://logixlysia.vercel.app",
  "bugs": {
    "url": "https://github.com/PunGrumpy/logixlysia/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PunGrumpy/logixlysia.git"
  },
  "license": "MIT",
  "author": "Noppakorn Kaewsalabnil <hello@pungrumpy.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js",
      "default": "./dist/otel.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bunup",
    "clean": "git clean -fdx .turbo dist node_modules coverage",
    "dev": "bunup --watch",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@elysiajs/node": "^1.4.5",
    "@types/bun": "^1.3.14",
    "bunup": "^0.16.32",
    "elysia": "^1.4.28"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "ai": "^6.0.0",
    "elysia": "^1.4.28",
    "typescript": "^6.0.2"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
