{
  "name": "logixlysia",
  "version": "6.9.2",
  "description": "🦊 Logixlysia is a logger for Elysia",
  "keywords": [
    "elysiajs",
    "logger",
    "logixlysia"
  ],
  "homepage": "https://logixlysia.vercel.app",
  "bugs": {
    "url": "https://github.com/PunGrumpy/logixlysia/issues"
  },
  "license": "MIT",
  "author": "Noppakorn Kaewsalabnil <hello@pungrumpy.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PunGrumpy/logixlysia.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js",
      "default": "./dist/otel.js"
    },
    "./enrichers": {
      "types": "./dist/enrichers.d.ts",
      "import": "./dist/enrichers.js",
      "default": "./dist/enrichers.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    },
    "./axiom": {
      "types": "./dist/axiom.d.ts",
      "import": "./dist/axiom.js",
      "default": "./dist/axiom.js"
    },
    "./hyperdx": {
      "types": "./dist/hyperdx.d.ts",
      "import": "./dist/hyperdx.js",
      "default": "./dist/hyperdx.js"
    },
    "./sentry": {
      "types": "./dist/sentry.d.ts",
      "import": "./dist/sentry.js",
      "default": "./dist/sentry.js"
    },
    "./posthog": {
      "types": "./dist/posthog.d.ts",
      "import": "./dist/posthog.js",
      "default": "./dist/posthog.js"
    },
    "./otlp": {
      "types": "./dist/otlp.d.ts",
      "import": "./dist/otlp.js",
      "default": "./dist/otlp.js"
    },
    "./datadog": {
      "types": "./dist/datadog.d.ts",
      "import": "./dist/datadog.js",
      "default": "./dist/datadog.js"
    },
    "./better-stack": {
      "types": "./dist/better-stack.d.ts",
      "import": "./dist/better-stack.js",
      "default": "./dist/better-stack.js"
    },
    "./loki": {
      "types": "./dist/loki.d.ts",
      "import": "./dist/loki.js",
      "default": "./dist/loki.js"
    },
    "./clickhouse": {
      "types": "./dist/clickhouse.d.ts",
      "import": "./dist/clickhouse.js",
      "default": "./dist/clickhouse.js"
    },
    "./desertant": {
      "types": "./dist/desertant.d.ts",
      "import": "./dist/desertant.js",
      "default": "./dist/desertant.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bunup",
    "clean": "git clean -fdx .turbo dist node_modules coverage",
    "dev": "bunup --watch",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@elysiajs/node": "^1.4.5",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.0",
    "bunup": "^0.16.32",
    "elysia": "^1.4.30"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "elysia": "^1.4.30",
    "typescript": ">=5.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
