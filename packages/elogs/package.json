{
  "name": "@pori15/elogs",
  "version": "2.0.0",
  "description": "🦊 Elogs is a logger for Elysia 2.0",
  "keywords": [
    "elogs",
    "elysiajs",
    "logger"
  ],
  "homepage": "https://elogs.vercel.app",
  "bugs": {
    "url": "https://github.com/pori15/elogs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eastgold15/elogs.git"
  },
  "license": "MIT",
  "author": "Noppakorn Kaewsalabnil <hello@pungrumpy.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "default": "./dist/otel.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./translator": {
      "types": "./dist/translator/drizzle.d.ts",
      "default": "./dist/translator/drizzle.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup ",
    "clean": "git clean -fdx .turbo dist node_modules coverage",
    "dev": "tsup --watch",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "tsc:build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "elysia": ">=2.0.0-exp.62",
    "pino-pretty": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
