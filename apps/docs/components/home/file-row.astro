---
import LiveBadge from './live-badge.astro'

interface Props {
  live: boolean
  name: string
  pct: number
  size: string
}

const { live, name, pct, size } = Astro.props
---

<div
  class="flex w-max min-w-full items-center justify-between gap-4 transition-[opacity,translate] duration-250 ease-out-strong data-[file=archived]:opacity-45 data-[file=entering]:-translate-y-1 data-[file=entering]:opacity-0 data-[file=exiting]:opacity-0 data-[file=exiting]:duration-150"
  data-file={live ? 'live' : 'archived'}
>
  <span class="flex items-center gap-2">
    <span class="whitespace-nowrap text-foreground" data-file-name>
      {name}
    </span>
    {live ? <LiveBadge /> : null}
  </span>
  <span class="flex items-center gap-3">
    <span
      aria-hidden="true"
      class="inline-block h-1 w-24 overflow-hidden rounded-full bg-foreground/8"
    >
      <span
        class="block h-full w-full origin-left rounded-full bg-[#067647] transition-[scale] duration-150 ease-out-strong motion-reduce:transition-none dark:bg-[#99ffe4]"
        data-file-bar
        style={`scale: ${pct / 100} 1`}
      ></span>
    </span>
    <span
      class="w-[7ch] whitespace-nowrap text-right text-muted-foreground tabular-nums"
      data-file-size
    >
      {size}
    </span>
  </span>
</div>
