---
import LiveBadge from './live-badge.astro'

interface Props {
  live: boolean
  name: string
  pct: number
  size: string
}

const { live, name, pct, size } = Astro.props
---

<div
  data-live-row={live ? '' : undefined}
  class:list={[
    'flex w-max items-center justify-between gap-4',
    live &&
      '-mx-1.5 min-w-[calc(100%+0.75rem)] rounded-md px-1.5',
    !live && 'min-w-full opacity-45'
  ]}
>
  <span class="flex items-center gap-2">
    <span class="whitespace-nowrap text-foreground">
      {name}
    </span>
    {live ? <LiveBadge /> : null}
  </span>
  <span class="flex items-center gap-3">
    <span
      aria-hidden="true"
      class="inline-block h-1 w-24 overflow-hidden rounded-full bg-foreground/8"
    >
      <span
        class="block h-full w-full origin-left rounded-full bg-[#067647] transition-[scale] duration-150 ease-out motion-reduce:transition-none dark:bg-[#99ffe4]"
        data-live-bar={live ? '' : undefined}
        style={`scale: ${pct / 100} 1`}
      ></span>
    </span>
    <span
      class="w-[7ch] whitespace-nowrap text-right text-muted-foreground tabular-nums"
      data-live-size={live ? '' : undefined}
    >
      {size}
    </span>
  </span>
</div>
