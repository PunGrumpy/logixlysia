---
// Mirrors logixlysia's real output: the `banner` startup box from
// extensions/banner.ts and the default log format from logger/create-logger.ts
// ({now} {service}{icon} {method} {pathname} {status} {duration} {message}{speed}),
// including chalk colors, method padding, duration rounding, and the ⚡ slow badge.
// The terminal is a dark panel in both themes, so each color is its dark-mode tone.
import RouteButton from './route-button.astro'
import RouteTemplate from './route-template.astro'
import TermLine from './term-line.astro'

type TermPart = [cls: string, text: string, hook?: string]

interface TermLineData {
  cls?: string
  delayMs?: number
  parts: TermPart[]
}

const c = {
  banner: 'text-panel-foreground/60',
  blue: 'text-[#a5d6ff]',
  bold: 'font-semibold',
  fg: 'text-panel-foreground',
  foxError: 'rounded-sm bg-[#ff8080]/20',
  foxInfo: 'rounded-sm bg-[#a5d6ff]/15',
  foxWarn: 'rounded-sm bg-[#ffc799]/20',
  mint: 'text-[#99ffe4]',
  muted: 'text-panel-muted',
  orange: 'text-[#ffc799]',
  red: 'text-[#ff8080]'
}

const blink = 'motion-safe:animate-[term-blink_1.1s_steps(1)_infinite]'

const banner: TermPart[][] = [
  [['', '┌─────────────────────────────┐']],
  [['', '│                             │']],
  [['', '│       Elysia v1.4.28        │']],
  [['', '│                             │']],
  [['', '│  🦊  http://localhost:3000  │']],
  [['', '│       logixlysia v6.6.0     │']],
  [['', '│                             │']],
  [['', '└─────────────────────────────┘']]
]

const bannerLines: TermLineData[] = banner.map((parts, index) => ({
  cls: index === banner.length - 1 ? `${c.banner} mb-4` : c.banner,
  delayMs: 35,
  parts
}))

const prefix = (time: string): TermPart => [
  c.muted,
  `2026-07-21 10:24:${time} [api-server] `
]

const termLines: TermLineData[] = [
  ...bannerLines,
  {
    delayMs: 500,
    parts: [
      prefix('31.804'),
      [c.foxInfo, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/'],
      ['', ' '],
      [c.mint, '200'],
      ['', ' '],
      [c.mint, '3ms']
    ]
  },
  {
    delayMs: 350,
    parts: [
      prefix('32.108'),
      [c.foxInfo, ' 🦊 '],
      ['', ' '],
      [`${c.blue} ${c.bold}`, 'POST   '],
      ['', ' '],
      [c.fg, '/auth/login'],
      ['', ' '],
      [c.mint, '201'],
      ['', ' '],
      [c.mint, '38ms']
    ]
  },
  {
    delayMs: 650,
    parts: [
      prefix('33.020'),
      [c.foxWarn, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/favicon.ico'],
      ['', ' '],
      [c.orange, '404'],
      ['', ' '],
      [c.mint, '1ms']
    ]
  },
  {
    delayMs: 400,
    parts: [
      prefix('33.412'),
      [c.foxInfo, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/reports/heavy'],
      ['', ' '],
      [c.mint, '200'],
      ['', ' '],
      [c.orange, '613ms']
    ]
  },
  {
    delayMs: 600,
    parts: [
      prefix('34.001'),
      [c.foxInfo, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/export'],
      ['', ' '],
      [c.mint, '200'],
      ['', ' '],
      [`${c.red} ${c.bold}`, '1.2s'],
      [c.orange, ' ⚡ slow']
    ]
  },
  {
    delayMs: 850,
    parts: [
      prefix('35.219'),
      [c.foxError, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/crash'],
      ['', ' '],
      [c.red, '500'],
      ['', ' '],
      [c.mint, '2ms']
    ]
  },
  {
    delayMs: 90,
    parts: [
      ['', '  └─ '],
      [c.mint, 'error'],
      ['', '  '],
      [c.fg, 'Route crashed']
    ]
  },
  {
    cls: blink,
    delayMs: 250,
    parts: [[c.muted, '▌']]
  }
]

const interactiveRoutes = [
  {
    id: 'home',
    lines: [
      [
        [c.muted, '', 'ts'],
        [c.foxInfo, ' 🦊 '],
        ['', ' '],
        [`${c.mint} ${c.bold}`, 'GET    '],
        ['', ' '],
        [c.fg, '/'],
        ['', ' '],
        [c.mint, '200'],
        ['', ' '],
        [c.mint, '', 'dur']
      ]
    ] as TermPart[][],
    max: 6,
    method: 'GET',
    methodColor: c.mint,
    min: 1,
    path: '/',
    status: '200'
  },
  {
    id: 'login',
    lines: [
      [
        [c.muted, '', 'ts'],
        [c.foxInfo, ' 🦊 '],
        ['', ' '],
        [`${c.blue} ${c.bold}`, 'POST   '],
        ['', ' '],
        [c.fg, '/auth/login'],
        ['', ' '],
        [c.mint, '201'],
        ['', ' '],
        [c.mint, '', 'dur']
      ]
    ] as TermPart[][],
    max: 60,
    method: 'POST',
    methodColor: c.blue,
    min: 24,
    path: '/auth/login',
    status: '201'
  },
  {
    id: 'export',
    lines: [
      [
        [c.muted, '', 'ts'],
        [c.foxInfo, ' 🦊 '],
        ['', ' '],
        [`${c.mint} ${c.bold}`, 'GET    '],
        ['', ' '],
        [c.fg, '/export'],
        ['', ' '],
        [c.mint, '200'],
        ['', ' '],
        [`${c.red} ${c.bold}`, '', 'dur'],
        [c.orange, ' ⚡ slow']
      ]
    ] as TermPart[][],
    max: 1600,
    method: 'GET',
    methodColor: c.mint,
    min: 1100,
    path: '/export',
    status: '200'
  },
  {
    id: 'crash',
    lines: [
      [
        [c.muted, '', 'ts'],
        [c.foxError, ' 🦊 '],
        ['', ' '],
        [`${c.mint} ${c.bold}`, 'GET    '],
        ['', ' '],
        [c.fg, '/crash'],
        ['', ' '],
        [c.red, '500'],
        ['', ' '],
        [c.mint, '', 'dur']
      ],
      [
        ['', '  └─ '],
        [c.mint, 'error'],
        ['', '  '],
        [c.fg, 'Route crashed']
      ]
    ] as TermPart[][],
    max: 4,
    method: 'GET',
    methodColor: c.mint,
    min: 1,
    path: '/crash',
    status: '500'
  }
]
---

<div
  class="overflow-hidden rounded-lg bg-panel text-panel-foreground ring-1 ring-ink/15"
  data-term
>
  <div
    class="relative flex h-11 items-center justify-center border-panel-border border-b px-20"
  >
    <div aria-hidden="true" class="absolute left-4 flex items-center gap-2">
      <span class="size-3 rounded-full bg-panel-foreground/15"></span>
      <span class="size-3 rounded-full bg-panel-foreground/15"></span>
      <span class="size-3 rounded-full bg-panel-foreground/15"></span>
    </div>
    <span class="truncate font-mono text-panel-muted text-xs">
      Terminal — api-server
    </span>
    <button
      aria-label="Pause animation"
      class="group absolute right-0.5 grid size-10 cursor-pointer place-items-center rounded-md text-panel-muted transition-transform duration-150 ease-out hover:bg-panel-hover hover:text-panel-foreground active:scale-[0.97] motion-reduce:transition-none"
      data-term-pause
      hidden
      type="button"
    >
      <span class="relative size-4">
        <svg
          aria-hidden="true"
          class="size-4 transition-[opacity,scale,filter] duration-300 ease-[cubic-bezier(0.2,0,0,1)] group-data-paused:scale-[0.25] group-data-paused:opacity-0 group-data-paused:blur-[4px]"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M10 5v14M14 5v14"></path>
        </svg>
        <svg
          aria-hidden="true"
          class="absolute inset-0 size-4 translate-x-[2px] scale-[0.25] opacity-0 blur-[4px] transition-[opacity,scale,filter] duration-300 ease-[cubic-bezier(0.2,0,0,1)] group-data-paused:scale-100 group-data-paused:opacity-100 group-data-paused:blur-0"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </span>
    </button>
  </div>
  <div
    aria-label="Example Logixlysia log output; requests sent with the buttons below append here"
    class="overflow-x-auto p-4 font-mono text-[0.8rem] text-panel-foreground leading-relaxed sm:p-6"
    data-term-body
    role="img"
  >
    <div class="whitespace-pre">
      <span class={c.muted}>$ </span
      ><span class={c.fg} data-term-cmd>bun run dev</span
      ><span data-term-caret class:list={[c.muted, blink]}>▌</span>
    </div>
    {termLines.map(line => (
      <TermLine cls={line.cls} delayMs={line.delayMs} parts={line.parts} />
    ))}
  </div>
  <div
    class="flex flex-wrap items-center gap-2 border-panel-border border-t px-4 py-3 sm:px-6"
  >
    <span class="mr-1 text-panel-muted text-sm">Send a request</span>
    {interactiveRoutes.map(route => (
      <RouteButton
        method={route.method}
        methodCls={route.methodColor}
        path={route.path}
        route={route.id}
      />
    ))}
  </div>
  <span class="sr-only" data-demo-status role="status"></span>
  {interactiveRoutes.map(route => (
    <RouteTemplate
      id={route.id}
      lines={route.lines}
      max={route.max}
      method={route.method}
      min={route.min}
      path={route.path}
      status={route.status}
    />
  ))}
</div>

<script>
  const MAX_TERMINAL_LINES = 28

  const sleep = (ms: number): Promise<void> =>
    new Promise(resolve => {
      setTimeout(resolve, ms)
    })

  const terminal = document.querySelector('[data-term]')
  const body = terminal?.querySelector<HTMLElement>('[data-term-body]')
  const cmd = terminal?.querySelector<HTMLElement>('[data-term-cmd]')
  const caret = terminal?.querySelector<HTMLElement>('[data-term-caret]')
  const pauseButton =
    terminal?.querySelector<HTMLElement>('[data-term-pause]') ?? null
  const lines = body
    ? [...body.querySelectorAll<HTMLElement>('[data-delay-ms]')]
    : []
  const command = cmd?.textContent ?? ''
  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches

  let interactive = false

  if (terminal && body && cmd && caret && !reduceMotion) {
    body.style.minHeight = `${body.offsetHeight}px`
    cmd.textContent = ''
    for (const line of lines) {
      line.style.display = 'none'
    }

    // The visible pause control keeps this indefinite replay WCAG 2.2.2 compliant.
    let visible = false
    let paused = false
    let onReady: (() => void) | undefined
    const ready = () => visible && !paused && !interactive
    const notifyReady = () => {
      if (ready() && onReady) {
        const resume = onReady
        onReady = undefined
        resume()
      }
    }
    const observer = new IntersectionObserver(
      entries => {
        visible = entries.some(entry => entry.isIntersecting)
        notifyReady()
      },
      { threshold: 0.35 }
    )
    observer.observe(terminal)

    const waitUntilReady = () =>
      ready()
        ? Promise.resolve()
        : new Promise<void>(resolve => {
            onReady = resolve
          })

    if (pauseButton) {
      pauseButton.hidden = false
      pauseButton.addEventListener('click', () => {
        paused = !paused
        pauseButton.toggleAttribute('data-paused', paused)
        terminal.toggleAttribute('data-term-paused', paused)
        pauseButton.setAttribute(
          'aria-label',
          paused ? 'Play animation' : 'Pause animation'
        )
        notifyReady()
      })
    }

    const typeCommand = () =>
      new Promise<void>(resolve => {
        let index = 0
        const tick = () => {
          if (!ready()) {
            onReady = tick
            return
          }
          if (index >= command.length) {
            resolve()
            return
          }
          cmd.textContent += command.charAt(index)
          index += 1
          setTimeout(tick, 55)
        }
        tick()
      })

    const revealLines = () =>
      new Promise<void>(resolve => {
        let index = 0
        const tick = () => {
          if (!ready()) {
            onReady = tick
            return
          }
          const line = lines[index]
          if (!line) {
            resolve()
            return
          }
          index += 1
          setTimeout(() => {
            line.style.display = ''
            tick()
          }, Number(line.dataset.delayMs) || 40)
        }
        tick()
      })

    const playRound = async () => {
      await waitUntilReady()
      cmd.textContent = ''
      caret.style.display = ''
      for (const line of lines) {
        line.style.display = 'none'
      }
      await sleep(400)
      await typeCommand()
      await sleep(350)
      caret.style.display = 'none'
      await revealLines()
      await sleep(3200)
    }

    const play = async () => {
      await playRound()
      if (!interactive) {
        play()
      }
    }
    play()
  }

  const statusRegion = document.querySelector<HTMLElement>('[data-demo-status]')

  const pad = (value: number, length = 2) => String(value).padStart(length, '0')
  const timestamp = () => {
    const now = new Date()
    return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}.${pad(now.getMilliseconds(), 3)} [api-server] `
  }

  const enterInteractive = () => {
    if (interactive || !body) {
      return
    }
    interactive = true
    if (cmd) {
      cmd.textContent = command
    }
    if (caret) {
      caret.style.display = 'none'
    }
    for (const line of lines) {
      line.style.display = ''
    }
    if (pauseButton) {
      pauseButton.hidden = true
    }
    const height = body.style.minHeight || `${body.offsetHeight}px`
    body.style.minHeight = height
    body.style.maxHeight = height
    body.style.overflowY = 'auto'
  }

  const appendLog = (id: string | undefined) => {
    const template = id
      ? document.querySelector<HTMLTemplateElement>(
          `[data-route-template="${id}"]`
        )
      : null
    if (!(template && body)) {
      return
    }
    enterInteractive()
    const min = Number(template.dataset.min) || 0
    const max = Number(template.dataset.max) || min
    const ms = Math.round(min + Math.random() * (max - min))
    const durationText = ms >= 1000 ? `${(ms / 1000).toFixed(1)}s` : `${ms}ms`
    const fragment = template.content.cloneNode(true) as DocumentFragment
    const ts = fragment.querySelector<HTMLElement>('[data-hook="ts"]')
    if (ts) {
      ts.textContent = timestamp()
    }
    const duration = fragment.querySelector<HTMLElement>('[data-hook="dur"]')
    if (duration) {
      duration.textContent = durationText
    }
    const cursor = lines.at(-1)
    if (cursor && cursor.parentElement === body) {
      cursor.before(fragment)
    } else {
      body.append(fragment)
    }
    while (body.childElementCount > MAX_TERMINAL_LINES) {
      body.firstElementChild?.remove()
    }
    body.scrollTop = body.scrollHeight
    if (statusRegion) {
      statusRegion.textContent = `${template.dataset.method} ${template.dataset.path} responded ${template.dataset.status} in ${durationText}`
    }
  }

  for (const button of document.querySelectorAll<HTMLElement>('[data-route]')) {
    button.addEventListener('click', () => appendLog(button.dataset.route))
  }
</script>
