---
// Mirrors logixlysia's real output: the `banner` startup box from
// extensions/banner.ts and the default log format from logger/create-logger.ts
// ({now} {service}{icon} {method} {pathname} {status} {duration} {message}{speed}),
// including chalk colors, method padding, duration rounding, and the ⚡ slow badge.
//
// The terminal is interactive, à la vercel.com/home: the route chips below it
// append a freshly timestamped log line. The first click stops the scripted
// replay and the terminal becomes an append-only session.
import RouteButton from './route-button.astro'
import RouteTemplate from './route-template.astro'
import TermLine from './term-line.astro'

type TermPart = [cls: string, text: string, hook?: string]

interface TermLineData {
  cls?: string
  /** Pause in ms before this line prints during the replay animation. */
  delay?: number
  parts: TermPart[]
}

// Dual-mode terminal palette: muted ink colors in light mode, vesper in dark.
const c = {
  banner: 'text-black/55 dark:text-white/60',
  blue: 'text-[#0550AE] dark:text-[#a5d6ff]',
  bold: 'font-semibold',
  fg: 'text-[#2D2D2D] dark:text-[#DADADA]',
  foxError: 'rounded-sm bg-[#C9303C]/10 dark:bg-[#ff8080]/20',
  foxInfo: 'rounded-sm bg-[#0550AE]/10 dark:bg-[#a5d6ff]/15',
  foxWarn: 'rounded-sm bg-[#B26A00]/15 dark:bg-[#ffc799]/20',
  mint: 'text-[#067647] dark:text-[#99ffe4]',
  muted: 'text-black/45 dark:text-white/40',
  orange: 'text-[#B26A00] dark:text-[#ffc799]',
  red: 'text-[#C9303C] dark:text-[#ff8080]'
}

const blink = 'motion-safe:animate-[term-blink_1.1s_steps(1)_infinite]'

const banner: TermPart[][] = [
  [['', '┌─────────────────────────────┐']],
  [['', '│                             │']],
  [['', '│       Elysia v1.4.28        │']],
  [['', '│                             │']],
  [['', '│  🦊  http://localhost:3000  │']],
  [['', '│       logixlysia v6.6.0     │']],
  [['', '│                             │']],
  [['', '└─────────────────────────────┘']]
]

const bannerLines: TermLineData[] = banner.map((parts, index) => ({
  cls: index === banner.length - 1 ? `${c.banner} mb-4` : c.banner,
  delay: 35,
  parts
}))

const prefix = (time: string): TermPart => [
  c.muted,
  `2026-07-21 10:24:${time} [api-server] `
]

const termLines: TermLineData[] = [
  ...bannerLines,
  {
    delay: 500,
    parts: [
      prefix('31.804'),
      [c.foxInfo, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/'],
      ['', ' '],
      [c.mint, '200'],
      ['', ' '],
      [c.mint, '3ms']
    ]
  },
  {
    delay: 350,
    parts: [
      prefix('32.108'),
      [c.foxInfo, ' 🦊 '],
      ['', ' '],
      [`${c.blue} ${c.bold}`, 'POST   '],
      ['', ' '],
      [c.fg, '/auth/login'],
      ['', ' '],
      [c.mint, '201'],
      ['', ' '],
      [c.mint, '38ms']
    ]
  },
  {
    delay: 650,
    parts: [
      prefix('33.020'),
      [c.foxWarn, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/favicon.ico'],
      ['', ' '],
      [c.orange, '404'],
      ['', ' '],
      [c.mint, '1ms']
    ]
  },
  {
    delay: 400,
    parts: [
      prefix('33.412'),
      [c.foxInfo, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/reports/heavy'],
      ['', ' '],
      [c.mint, '200'],
      ['', ' '],
      [c.orange, '613ms']
    ]
  },
  {
    delay: 600,
    parts: [
      prefix('34.001'),
      [c.foxInfo, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/export'],
      ['', ' '],
      [c.mint, '200'],
      ['', ' '],
      [`${c.red} ${c.bold}`, '1.2s'],
      [c.orange, ' ⚡ slow']
    ]
  },
  {
    delay: 850,
    parts: [
      prefix('35.219'),
      [c.foxError, ' 🦊 '],
      ['', ' '],
      [`${c.mint} ${c.bold}`, 'GET    '],
      ['', ' '],
      [c.fg, '/crash'],
      ['', ' '],
      [c.red, '500'],
      ['', ' '],
      [c.mint, '2ms']
    ]
  },
  {
    delay: 90,
    parts: [
      ['', '  └─ '],
      [c.mint, 'error'],
      ['', '  '],
      [c.fg, 'Route crashed']
    ]
  },
  {
    cls: blink,
    delay: 250,
    parts: [[c.muted, '▌']]
  }
]

// Routes the visitor can fire into the terminal. `min`/`max` bound the
// randomized duration; the ts/dur hooks are filled by the script on click.
const interactiveRoutes = [
  {
    id: 'home',
    lines: [
      [
        [c.muted, '', 'ts'],
        [c.foxInfo, ' 🦊 '],
        ['', ' '],
        [`${c.mint} ${c.bold}`, 'GET    '],
        ['', ' '],
        [c.fg, '/'],
        ['', ' '],
        [c.mint, '200'],
        ['', ' '],
        [c.mint, '', 'dur']
      ]
    ] as TermPart[][],
    max: 6,
    method: 'GET',
    methodColor: c.mint,
    min: 1,
    path: '/',
    status: '200'
  },
  {
    id: 'login',
    lines: [
      [
        [c.muted, '', 'ts'],
        [c.foxInfo, ' 🦊 '],
        ['', ' '],
        [`${c.blue} ${c.bold}`, 'POST   '],
        ['', ' '],
        [c.fg, '/auth/login'],
        ['', ' '],
        [c.mint, '201'],
        ['', ' '],
        [c.mint, '', 'dur']
      ]
    ] as TermPart[][],
    max: 60,
    method: 'POST',
    methodColor: c.blue,
    min: 24,
    path: '/auth/login',
    status: '201'
  },
  {
    id: 'export',
    lines: [
      [
        [c.muted, '', 'ts'],
        [c.foxInfo, ' 🦊 '],
        ['', ' '],
        [`${c.mint} ${c.bold}`, 'GET    '],
        ['', ' '],
        [c.fg, '/export'],
        ['', ' '],
        [c.mint, '200'],
        ['', ' '],
        [`${c.red} ${c.bold}`, '', 'dur'],
        [c.orange, ' ⚡ slow']
      ]
    ] as TermPart[][],
    max: 1600,
    method: 'GET',
    methodColor: c.mint,
    min: 1100,
    path: '/export',
    status: '200'
  },
  {
    id: 'crash',
    lines: [
      [
        [c.muted, '', 'ts'],
        [c.foxError, ' 🦊 '],
        ['', ' '],
        [`${c.mint} ${c.bold}`, 'GET    '],
        ['', ' '],
        [c.fg, '/crash'],
        ['', ' '],
        [c.red, '500'],
        ['', ' '],
        [c.mint, '', 'dur']
      ],
      [
        ['', '  └─ '],
        [c.mint, 'error'],
        ['', '  '],
        [c.fg, 'Route crashed']
      ]
    ] as TermPart[][],
    max: 4,
    method: 'GET',
    methodColor: c.mint,
    min: 1,
    path: '/crash',
    status: '500'
  }
]
---

<section class="mx-auto w-full max-w-3xl">
  <div
    class="overflow-hidden rounded-3xl bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.06),0_1px_2px_-1px_rgb(0_0_0/0.06),0_2px_4px_0_rgb(0_0_0/0.04)] dark:bg-[#131313] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.08)]"
    data-term
  >
    <div
      class="relative flex h-11 items-center justify-center border-[#EBEBEB] border-b px-20 dark:border-white/8"
    >
      <div class="absolute left-4 flex items-center gap-2">
        <span
          class="size-3.5 rounded-full bg-[oklch(71.3%_0.171_26)] dark:bg-[#323232]"
        ></span>
        <span
          class="size-3.5 rounded-full bg-[oklch(82.5%_0.159_80.9)] dark:bg-[#323232]"
        ></span>
        <span
          class="size-3.5 rounded-full bg-[oklch(88.4%_0_0)] dark:bg-[#323232]"
        ></span>
      </div>
      <span
        class="truncate font-medium text-[#6E6E6E] text-sm dark:text-[#888888]"
      >
        Terminal — api-server
      </span>
      <button
        aria-label="Pause animation"
        class="group absolute right-2.5 grid size-9 cursor-pointer place-items-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        data-term-pause
        hidden
        type="button"
      >
        <span class="relative size-4">
          <svg
            aria-hidden="true"
            class="size-4 transition-[opacity,scale,filter] duration-300 ease-[cubic-bezier(0.2,0,0,1)] group-data-paused:scale-25 group-data-paused:opacity-0 group-data-paused:blur-xs"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M10 5v14M14 5v14"></path>
          </svg>
          <svg
            aria-hidden="true"
            class="absolute inset-0 size-4 translate-x-px scale-25 opacity-0 blur-xs transition-[opacity,scale,filter] duration-300 ease-[cubic-bezier(0.2,0,0,1)] group-data-paused:scale-100 group-data-paused:opacity-100 group-data-paused:blur-none"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </span>
      </button>
    </div>
    <div
      aria-label="Example Logixlysia log output; requests sent with the buttons below append here"
      class="overflow-x-auto p-4 font-mono text-[#2D2D2D] text-[0.8rem] leading-relaxed dark:text-[#DADADA]"
      data-term-body
      role="img"
    >
      <div class="whitespace-pre">
        <span class={c.muted}>$ </span
        ><span class={c.fg} data-term-cmd>bun run dev</span
        ><span data-term-caret class:list={[c.muted, blink]}>▌</span>
      </div>
      {termLines.map(line => (
        <TermLine cls={line.cls} delay={line.delay} parts={line.parts} />
      ))}
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
    <span class="text-muted-foreground text-sm">Send a request</span>
    {interactiveRoutes.map(route => (
      <RouteButton
        method={route.method}
        methodCls={route.methodColor}
        path={route.path}
        route={route.id}
      />
    ))}
  </div>
  <span class="sr-only" data-demo-status role="status"></span>
  {interactiveRoutes.map(route => (
    <RouteTemplate
      id={route.id}
      lines={route.lines}
      max={route.max}
      method={route.method}
      min={route.min}
      path={route.path}
      status={route.status}
    />
  ))}
</section>

<script>
  const sleep = (ms: number) => new Promise(resolve => setTimeout(resolve, ms))

  const terminal = document.querySelector('[data-term]')
  const body = terminal?.querySelector<HTMLElement>('[data-term-body]')
  const cmd = terminal?.querySelector<HTMLElement>('[data-term-cmd]')
  const caret = terminal?.querySelector<HTMLElement>('[data-term-caret]')
  const pauseButton =
    terminal?.querySelector<HTMLElement>('[data-term-pause]') ?? null
  const lines = body
    ? [...body.querySelectorAll<HTMLElement>('[data-delay]')]
    : []
  const command = cmd?.textContent ?? ''
  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches

  // Flips on the first user-sent request: the scripted replay parks itself
  // and the terminal becomes an append-only session.
  let interactive = false

  if (terminal && body && cmd && caret && !reduceMotion) {
    // Reserve the final height up front so the replay never shifts layout.
    body.style.minHeight = `${body.offsetHeight}px`
    cmd.textContent = ''
    for (const line of lines) {
      line.style.display = 'none'
    }

    // Replay only while the terminal is on screen, not paused by the user,
    // and not taken over by the interactive buttons (the visible pause
    // control keeps this indefinite replay WCAG 2.2.2 compliant). One
    // consumer awaits the gate at a time, so a single `onReady` slot is
    // enough.
    let visible = false
    let paused = false
    let onReady: (() => void) | undefined
    const ready = () => visible && !paused && !interactive
    const notifyReady = () => {
      if (ready() && onReady) {
        const resume = onReady
        onReady = undefined
        resume()
      }
    }
    const observer = new IntersectionObserver(
      entries => {
        visible = entries.some(entry => entry.isIntersecting)
        notifyReady()
      },
      { threshold: 0.35 }
    )
    observer.observe(terminal)

    const waitUntilReady = () =>
      ready()
        ? Promise.resolve()
        : new Promise<void>(resolve => {
            onReady = resolve
          })

    if (pauseButton) {
      pauseButton.hidden = false
      pauseButton.addEventListener('click', () => {
        paused = !paused
        pauseButton.toggleAttribute('data-paused', paused)
        terminal.toggleAttribute('data-term-paused', paused)
        pauseButton.setAttribute(
          'aria-label',
          paused ? 'Play animation' : 'Pause animation'
        )
        notifyReady()
      })
    }

    // setTimeout chains instead of awaited loops keep each frame's timing
    // identical while staying sequential.
    const typeCommand = () =>
      new Promise<void>(resolve => {
        let index = 0
        const tick = () => {
          if (!ready()) {
            onReady = tick
            return
          }
          if (index >= command.length) {
            resolve()
            return
          }
          cmd.textContent += command.charAt(index)
          index += 1
          setTimeout(tick, 55)
        }
        tick()
      })

    const revealLines = () =>
      new Promise<void>(resolve => {
        let index = 0
        const tick = () => {
          if (!ready()) {
            onReady = tick
            return
          }
          const line = lines[index]
          if (!line) {
            resolve()
            return
          }
          index += 1
          setTimeout(() => {
            line.style.display = ''
            tick()
          }, Number(line.dataset.delay) || 40)
        }
        tick()
      })

    const playRound = async () => {
      await waitUntilReady()
      // Clear the screen, then replay the whole session.
      cmd.textContent = ''
      caret.style.display = ''
      for (const line of lines) {
        line.style.display = 'none'
      }
      await sleep(400)
      await typeCommand()
      await sleep(350)
      caret.style.display = 'none'
      await revealLines()
      // Hold the finished session before clearing for the next run.
      await sleep(3200)
    }

    const play = () => {
      playRound().then(() => {
        if (!interactive) {
          play()
        }
      })
    }
    play()
  }

  // — Interactive demo: the route chips append real log lines. —
  const statusRegion = document.querySelector<HTMLElement>('[data-demo-status]')

  const pad = (value: number, length = 2) => String(value).padStart(length, '0')
  const timestamp = () => {
    const now = new Date()
    return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}.${pad(now.getMilliseconds(), 3)} [api-server] `
  }

  const enterInteractive = () => {
    if (interactive || !body) {
      return
    }
    interactive = true
    // Land the terminal in its finished state: full command, every line shown.
    if (cmd) {
      cmd.textContent = command
    }
    if (caret) {
      caret.style.display = 'none'
    }
    for (const line of lines) {
      line.style.display = ''
    }
    if (pauseButton) {
      pauseButton.hidden = true
    }
    // Freeze the height: from here new lines scroll inside the terminal
    // instead of growing the page on every click.
    const height = body.style.minHeight || `${body.offsetHeight}px`
    body.style.minHeight = height
    body.style.maxHeight = height
    body.style.overflowY = 'auto'
  }

  const appendLog = (id: string | undefined) => {
    const template = id
      ? document.querySelector<HTMLTemplateElement>(
          `[data-route-template="${id}"]`
        )
      : null
    if (!(template && body)) {
      return
    }
    enterInteractive()
    const min = Number(template.dataset.min) || 0
    const max = Number(template.dataset.max) || min
    const ms = Math.round(min + Math.random() * (max - min))
    const durationText = ms >= 1000 ? `${(ms / 1000).toFixed(1)}s` : `${ms}ms`
    const fragment = template.content.cloneNode(true) as DocumentFragment
    const ts = fragment.querySelector<HTMLElement>('[data-hook="ts"]')
    if (ts) {
      ts.textContent = timestamp()
    }
    const duration = fragment.querySelector<HTMLElement>('[data-hook="dur"]')
    if (duration) {
      duration.textContent = durationText
    }
    // Keep the blinking block cursor as the last line.
    const cursor = lines.at(-1)
    if (cursor && cursor.parentElement === body) {
      cursor.before(fragment)
    } else {
      body.append(fragment)
    }
    // Bounded backlog: the oldest lines scroll away like a real terminal.
    while (body.childElementCount > 28) {
      body.firstElementChild?.remove()
    }
    body.scrollTop = body.scrollHeight
    if (statusRegion) {
      statusRegion.textContent = `${template.dataset.method} ${template.dataset.path} responded ${template.dataset.status} in ${durationText}`
    }
  }

  for (const button of document.querySelectorAll<HTMLElement>('[data-route]')) {
    button.addEventListener('click', () => appendLog(button.dataset.route))
  }
</script>
