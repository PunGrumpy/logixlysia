---
import BrandIcon from './brand-icon.astro'

interface Props {
  blurb: string
  href: string
  icon: string
  iconFillRule?: 'evenodd'
  iconViewBox?: string
  name: string
}

const { blurb, href, icon, iconFillRule, iconViewBox, name } = Astro.props
---

<li class="grid max-sm:last:col-span-2">
  <a
    class="flex flex-col gap-2 bg-background px-4 py-6 hover:bg-muted focus-visible:-outline-offset-2 sm:px-6 lg:px-10 lg:py-8"
    href={href}
  >
    <span class="flex items-center gap-2.5 font-medium text-base text-foreground">
      <BrandIcon fillRule={iconFillRule} path={icon} viewBox={iconViewBox} />
      {name}
    </span>
    <span class="text-muted-foreground text-sm/6 text-pretty">{blurb}</span>
  </a>
</li>
