---
import { NEW_TAB_HINT_ID } from 'blume/core/new-tab.ts'
import Demo from './demo.astro'
import InstallCommand from './install-command.astro'

interface Props {
  releaseUrl: string
  version: string
}

const { version, releaseUrl } = Astro.props
---

<section class="border-border border-y">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <div class="px-4 pt-14 pb-12 sm:px-6 sm:pt-20 lg:px-10 lg:pt-24 lg:pb-14">
      <a
        aria-describedby={NEW_TAB_HINT_ID}
        class="group -my-2 inline-flex items-center gap-3 py-2 text-muted-foreground text-sm/6 hover:text-foreground"
        href={releaseUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        <span
          class="rounded-sm bg-foreground px-1.5 py-0.5 font-mono text-background text-xs/5 tabular-nums"
        >
          v{version}
        </span>
        <span>Read the latest release notes</span>
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-150 ease-out group-hover:translate-x-0.5 motion-reduce:transition-none"
        >
          →
        </span>
      </a>
      <h1
        class="mt-8 max-w-[17ch] font-medium text-5xl tracking-[-0.045em] text-balance sm:text-6xl lg:text-7xl xl:text-8xl"
      >
        Understand every request your app serves
      </h1>
      <div
        class="mt-10 grid gap-8 lg:mt-12 lg:grid-cols-12 lg:items-end lg:gap-10"
      >
        <p
          class="max-w-[46ch] text-lg/8 text-muted-foreground text-pretty lg:col-span-6"
        >
          Logixlysia turns Elysia traffic into structured, colorful log lines —
          then filters the noise, samples the volume, and ships the rest to the
          platform you already use.
        </p>
        <div
          class="flex flex-col gap-3 sm:flex-row lg:col-span-6 lg:justify-end"
        >
          <InstallCommand command="bun add logixlysia" />
          <a
            class="inline-flex h-14 shrink-0 items-center justify-center rounded-lg bg-foreground px-6 font-medium text-background text-sm transition-transform duration-150 ease-out [-webkit-tap-highlight-color:transparent] hover:bg-foreground/90 active:scale-[0.97] motion-reduce:transition-none"
            href="/docs/introduction"
          >
            Read the docs
          </a>
        </div>
      </div>
    </div>
    <div class="border-border border-t bg-signal p-2 sm:p-6 lg:p-10">
      <Demo />
    </div>
  </div>
</section>
