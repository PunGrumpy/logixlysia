---
interface Props {
  command: string
  /** `inverse` is the dark field that sits on the signal-orange slab. */
  tone?: 'default' | 'inverse'
}

const { command, tone = 'default' } = Astro.props
const inverse = tone === 'inverse'
---

<div
  data-copy={command}
  class:list={[
    'flex h-14 w-full min-w-0 items-center justify-between gap-3 rounded-lg pr-1.5 pl-4 sm:w-90',
    inverse
      ? 'bg-panel text-panel-foreground'
      : 'border border-foreground/90 bg-code text-foreground'
  ]}
>
  <div class="flex min-w-0 gap-2.5 font-mono text-[15px]">
    <span
      aria-hidden="true"
      class:list={['select-none', inverse ? 'text-signal' : 'text-accent']}
      >$</span
    >
    <code class="truncate">{command}</code>
  </div>
  <button
    aria-label="Copy command"
    type="button"
    class:list={[
      'group grid size-11 shrink-0 cursor-pointer place-items-center rounded-[2px] text-ink transition-transform duration-150 ease-out [-webkit-tap-highlight-color:transparent] active:scale-[0.97] motion-reduce:transition-none',
      inverse ? 'bg-panel-foreground hover:bg-white' : 'bg-signal hover:brightness-95'
    ]}
  >
    <span class="relative size-4">
      <svg
        aria-hidden="true"
        class="size-4 transition-[opacity,scale,filter] duration-300 ease-[cubic-bezier(0.2,0,0,1)] group-data-copied:scale-[0.25] group-data-copied:opacity-0 group-data-copied:blur-[4px]"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <rect height="13" rx="2" width="13" x="8" y="8"></rect>
        <path d="M5 16V5a1 1 0 0 1 1-1h11"></path>
      </svg>
      <svg
        aria-hidden="true"
        class="absolute inset-0 size-4 scale-[0.25] opacity-0 blur-[4px] transition-[opacity,scale,filter] duration-300 ease-[cubic-bezier(0.2,0,0,1)] group-data-copied:scale-100 group-data-copied:opacity-100 group-data-copied:blur-0"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path d="M5 12l5 5L20 7"></path>
      </svg>
    </span>
  </button>
  <span class="sr-only" data-copy-status role="status"></span>
</div>

<script>
  for (const block of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    const button = block.querySelector('button')
    const status = block.querySelector('[data-copy-status]')
    if (!button) {
      continue
    }
    let timeout: ReturnType<typeof setTimeout> | undefined
    button.addEventListener('click', async () => {
      const value = block.dataset.copy
      if (!value) {
        return
      }
      await navigator.clipboard.writeText(value)
      button.dataset.copied = ''
      if (status) {
        status.textContent = 'Copied'
      }
      clearTimeout(timeout)
      timeout = setTimeout(() => {
        delete button.dataset.copied
        if (status) {
          status.textContent = ''
        }
      }, 1200)
    })
  }
</script>
