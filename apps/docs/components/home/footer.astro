---
import FooterColumn from './footer-column.astro'

const columns = [
  [
    { href: '/docs/introduction', label: 'Documentation' },
    { href: '/changelog', label: 'Changelog' }
  ],
  [
    { href: '/docs/features/request-context', label: 'Request context' },
    { href: '/docs/features/filtering', label: 'Filtering' },
    { href: '/docs/features/sampling', label: 'Sampling' },
    { href: '/docs/features/enrichers', label: 'Enrichers' },
    { href: '/docs/features/file-logging', label: 'File logging' },
    { href: '/docs/adapters/overview', label: 'Adapters' }
  ],
  [
    { href: 'https://github.com/PunGrumpy/logixlysia', label: 'GitHub' },
    { href: 'https://www.npmjs.com/package/logixlysia', label: 'npm' },
    { href: 'https://elysiajs.com', label: 'Elysia.js' }
  ]
]
---

<footer class="relative mt-16 overflow-clip sm:mt-24 md:mt-32">
  <div class="mx-auto max-w-7xl px-4 pt-16 pb-[18vw] lg:pt-24 lg:pb-56">
    <div class="flex flex-col items-start justify-between gap-10 lg:flex-row">
      <p class="text-muted-foreground text-sm">
        🦊 Logixlysia, Built by{' '}
        <a
          class="text-foreground transition-colors hover:text-muted-foreground"
          href="https://www.pungrumpy.com"
          rel="noopener"
          target="_blank"
          >Noppakorn Kaewsalabnil</a
        >
      </p>
      <nav
        aria-label="Footer"
        class="flex flex-col gap-10 sm:flex-row sm:gap-16 lg:gap-24"
      >
        {columns.map(column => <FooterColumn links={column} />)}
      </nav>
    </div>
  </div>
  <span
    aria-hidden="true"
    class="-translate-x-1/2 bottom-[-0.24em] pointer-events-none absolute left-1/2 select-none whitespace-nowrap font-medium text-[20vw] text-black/4 leading-none tracking-tight lg:text-[18rem] dark:text-white/4"
  >
    Logixlysia
  </span>
</footer>
