---
interface Props {
  cls?: string
  name: string
  value: string
}

const { cls, name, value } = Astro.props
---

<tr class="[&>td:first-child]:pl-2 [&>td:last-child]:pr-2">
  <td class="whitespace-nowrap py-2 pr-6 text-muted-foreground">
    {name}
  </td>
  <td
    class:list={[
      'whitespace-nowrap py-2',
      cls ?? 'text-foreground'
    ]}
  >
    {value}
  </td>
</tr>
