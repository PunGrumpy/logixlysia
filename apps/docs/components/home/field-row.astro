---
interface Props {
  cls?: string
  name: string
  value: string
}

const { cls, name, value } = Astro.props
---

<tr
  class="transition-[opacity,translate] duration-250 ease-out-strong data-hidden:translate-y-1 data-hidden:opacity-0 [&>td:first-child]:pl-2 [&>td:last-child]:pr-2"
>
  <td class="whitespace-nowrap py-2 pr-6 text-muted-foreground">
    {name}
  </td>
  <td
    class:list={[
      'whitespace-nowrap py-2',
      cls ?? 'text-foreground'
    ]}
  >
    {value}
  </td>
</tr>
