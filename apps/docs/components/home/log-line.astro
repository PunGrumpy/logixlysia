---
import TermPart from "./term-part.astro";

interface Props {
  kept: boolean;
  parts: [cls: string, text: string][];
}

const { kept, parts } = Astro.props;
---

<div
  data-kept={kept ? '' : undefined}
  data-log
  class:list={[
    'whitespace-pre transition-opacity duration-300',
    !kept && 'opacity-35'
  ]}
>
  {parts.map(part => <TermPart cls={part[0]} text={part[1]} />)}
</div>
