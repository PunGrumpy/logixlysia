---
import TermLine from './term-line.astro'

interface Props {
  id: string
  lines: [cls: string, text: string, hook?: string][][]
  max: number
  method: string
  min: number
  path: string
  status: string
}

const { id, lines, max, method, min, path, status } = Astro.props
---

<template
  data-max={max}
  data-method={method}
  data-min={min}
  data-path={path}
  data-route-template={id}
  data-status={status}
>
  {lines.map(parts => <TermLine parts={parts} />)}
</template>
