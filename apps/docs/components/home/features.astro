---
// Demo data lives here so every table row keeps its colors next to its values.
import ContextRow from './context-row.astro'
import FieldRow from './field-row.astro'
import FileRow from './file-row.astro'
import FeatureFigure from './feature-figure.astro'
import FilterRow from './filter-row.astro'
import SamplingRow from './sampling-row.astro'
import SectionHeading from './section-heading.astro'

const c = {
  barMint: 'bg-[#067647] dark:bg-[#99ffe4]',
  barOrange: 'bg-[#B26A00] dark:bg-[#ffc799]',
  barRed: 'bg-[#C9303C] dark:bg-[#ff8080]',
  blue: 'text-[#0550AE] dark:text-[#a5d6ff]',
  bold: 'font-semibold',
  fg: 'text-foreground',
  foxInfo: 'rounded-sm bg-[#0550AE]/10 dark:bg-[#a5d6ff]/15',
  mint: 'text-[#067647] dark:text-[#99ffe4]',
  muted: 'text-muted-foreground',
  orange: 'text-[#B26A00] dark:text-[#ffc799]',
  red: 'text-[#C9303C] dark:text-[#ff8080]'
}

const th =
  'border-border border-b pb-2 pr-6 text-left font-normal text-[11px] text-muted-foreground uppercase tracking-wider'

const contextRows = [
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '3ms',
    durationCls: c.mint,
    ip: '10.0.0.42',
    method: 'GET',
    methodCls: c.mint,
    path: '/',
    status: '200',
    statusCls: c.mint,
    time: '10:24:31.804'
  },
  {
    barCls: c.barMint,
    barPct: 6,
    duration: '38ms',
    durationCls: c.mint,
    ip: '10.0.0.17',
    method: 'POST',
    methodCls: c.blue,
    path: '/auth/login',
    status: '201',
    statusCls: c.mint,
    time: '10:24:32.108'
  },
  {
    barCls: c.barOrange,
    barPct: 55,
    duration: '613ms',
    durationCls: c.orange,
    ip: '172.16.4.9',
    method: 'GET',
    methodCls: c.mint,
    path: '/reports',
    status: '200',
    statusCls: c.mint,
    time: '10:24:33.412'
  },
  {
    barCls: c.barRed,
    barPct: 92,
    duration: '1.2s',
    durationCls: c.red,
    ip: '10.0.0.42',
    method: 'GET',
    methodCls: c.mint,
    path: '/export',
    status: '200',
    statusCls: c.mint,
