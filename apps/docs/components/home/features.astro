    name: 'logs/api.log.2026-07-21-09-47-03-271-66425271402958.gz',
    pct: 12,
    size: '1.2 MB'
  },
  {
    live: false,
    name: 'logs/api.log.2026-07-21-08-52-19-604-63141604183217.gz',
    pct: 11,
    size: '1.1 MB'
  }
]
---

<section aria-labelledby="hp-context" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="Request context"
      href="/docs/features/request-context"
      id="hp-context"
      linkLabel="Explore request context"
      title="See every request, end to end"
    >
      Method, path, status, duration, and client IP land on one readable line —
      captured automatically for every request, with no wrappers and no
      middleware chains.
    </SectionHeading>
    <FeatureFigure data-tail label="Access log">
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset" slot="chips">.use(logixlysia())</span>
      <table
        aria-label="Example access log: five requests, each with its time, method, path, status, duration, and client IP"
        class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
      >
        <thead>
          <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
            <th class={th} scope="col">Time</th>
            <th class={th} scope="col">Method</th>
            <th class={th} scope="col">Path</th>
            <th class={th} scope="col">Status</th>
            <th class={th} scope="col">Duration</th>
            <th scope="col" class:list={[th, 'pr-0']}>IP</th>
          </tr>
        </thead>
        <tbody>
          {contextRows.map(row => (
            <ContextRow {...row} />
          ))}
        </tbody>
      </table>
    </FeatureFigure>
  </div>
</section>

<section aria-labelledby="hp-filtering" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="Filtering"
      href="/docs/features/filtering"
      id="hp-filtering"
      linkLabel="Explore filtering"
      title="Keep the noise out"
    >
      Filter by level, HTTP method, or status code. Health checks and favicons
      fade away — warnings and errors stay loud.
    </SectionHeading>
    <FeatureFigure data-filter-demo label="Console">
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset transition-[background-color] duration-200 ease-[ease]" data-filter-chip slot="chips">
        filter: &lbrace; level: ['warn', 'error'] &rbrace;
      </span>
      <table
        aria-label="Example filter config keeping only warnings and errors; filtered-out request logs appear dimmed"
        class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
      >
        <thead>
          <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
            <th class={th} scope="col">Method</th>
            <th class={th} scope="col">Path</th>
            <th class={th} scope="col">Status</th>
            <th class={th} scope="col">Duration</th>
          </tr>
        </thead>
        <tbody>
          {filterRows.map(row => (
            <FilterRow {...row} />
          ))}
        </tbody>
      </table>
    </FeatureFigure>
  </div>
</section>

<section aria-labelledby="hp-sampling" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="Sampling"
      href="/docs/features/sampling"
      id="hp-sampling"
      linkLabel="Explore sampling"
      tag="New"
      title="Keep the bill flat"
    >
      Head sampling keeps a percentage of high-volume levels. Tail sampling
      replays the dropped lines the moment a request errors or runs slow —
      routine traffic costs almost nothing, interesting requests stay complete.
    </SectionHeading>
    <FeatureFigure data-sampling-demo label="Console">
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset transition-[background-color] duration-200 ease-[ease]" data-head-chip slot="chips">
        head: &lbrace; INFO: 10 &rbrace;
      </span>
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset transition-[background-color] duration-200 ease-[ease]" data-tail-chip slot="chips">
        tail: &lbrace; status: 400 &rbrace;
      </span>
      <table
        aria-label="Example sampling config: routine request logs dim as head sampling drops them, then a 500 response replays every line from that request"
        class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
      >
        <thead>
          <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
            <th class={th} scope="col">Method</th>
            <th class={th} scope="col">Path</th>
            <th class={th} scope="col">Status</th>
            <th class={th} scope="col">Duration</th>
            <th scope="col" class:list={[th, 'pr-0 text-right']}>Sampling</th>
          </tr>
        </thead>
        <tbody>
          {samplingRows.map(row => (
            <SamplingRow {...row} />
          ))}
        </tbody>
      </table>
    </FeatureFigure>
  </div>
</section>

<section aria-labelledby="hp-enrichers" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="Enrichers"
      href="/docs/features/enrichers"
      id="hp-enrichers"
      linkLabel="Explore enrichers"
      tag="New"
      title="Add context once, see it everywhere"
    >
      Enrichers contribute fields to every request — trace ids from the
      traceparent header, geo from your platform's headers, parsed user agents.
      Set them up once and the fields reach the console, files, and every
      adapter.
    </SectionHeading>
    <FeatureFigure data-enrichers-demo label="Enriched request">
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset transition-[background-color] duration-200 ease-[ease]" data-enrichers-chip slot="chips">
        enrichers: [traceparentEnricher(), geoEnricher()]
      </span>
      <table
        aria-label="Example enricher config: a table of fields attached to one request — trace id, geo city and country, browser, and device"
        class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
      >
        <thead>
          <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
            <th class={th} scope="col">Field</th>
            <th class={th} scope="col">Value</th>
          </tr>
        </thead>
        <tbody>
          {enricherFields.map(field => (
            <FieldRow cls={field.cls} name={field.name} value={field.value} />
          ))}
        </tbody>
      </table>
    </FeatureFigure>
  </div>
</section>

<section aria-labelledby="hp-files" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="File rotation"
      href="/docs/features/file-logging"
      id="hp-files"
      linkLabel="Explore file logging"
      title="Outlive the terminal"
    >
      Write logs to disk with size- and time-based rotation built in —
      yesterday's file compresses and rotates away on its own.
    </SectionHeading>
    <FeatureFigure
      aria-label="Example rotation config: the live log file's size meter grows to the 10 MB cap, then rotates while older files compress"
      data-rotation
      label="Log directory"
      role="img"
    >
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset" slot="chips">
        logRotation: &lbrace; maxSize: '10m', maxFiles: 2, compress: true &rbrace;
      </span>
      <div
        class="grid gap-1 px-2 font-mono text-[0.8rem] leading-relaxed transition-opacity duration-150 ease-out-strong data-resetting:opacity-0"
        data-files
      >
        {files.map(file => (
          <FileRow
            live={file.live}
            name={file.name}
            pct={file.pct}
            size={file.size}
          />
        ))}
      </div>
    </FeatureFigure>
  </div>
</section>

<script>
  const sleep = (ms: number): Promise<void> =>
    new Promise(resolve => {
      setTimeout(resolve, ms)
    })

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches

  // Bounded replay (WCAG 2.2.2): play a few rounds, each only once the demo is
  // on screen, then rest on the static markup.
  const replay = (
    demo: Element,
    rounds: number,
    round: (index: number) => Promise<void>
  ): Promise<void> => {
    let visible = false
    let onVisible: (() => void) | undefined
    const observer = new IntersectionObserver(
      entries => {
        visible = entries.some(entry => entry.isIntersecting)
        if (visible && onVisible) {
          onVisible()
          onVisible = undefined
        }
      },
      { threshold: 0.35 }
    )
    observer.observe(demo)
    const play = async (index: number): Promise<void> => {
      if (index === rounds) {
        observer.disconnect()
        return
      }
      if (!visible) {
        await new Promise<void>(resolve => {
          onVisible = resolve
        })
      }
      await round(index)
      await play(index + 1)
    }
    return play(0)
  }

  const mark = (elements: Element[], attribute: string, on: boolean) => {
    for (const element of elements) {
      element.toggleAttribute(attribute, on)
    }
  }

  const reveal = async (rows: HTMLElement[], gapMs: number) => {
    for (const [index, row] of rows.entries()) {
      setTimeout(() => {
        delete row.dataset.hidden
      }, index * gapMs)
    }
    await sleep(rows.length * gapMs)
  }

  const light = (chip: Element | null, on: boolean) => {
    chip?.classList.toggle('bg-signal/20', on)
  }

  const setName = (row: Element, name: string) => {
    const label = row.querySelector('[data-file-name]')
    if (label) {
      label.textContent = name
    }
  }

  const tailDemo = document.querySelector('[data-tail]')
  if (tailDemo && !reduceMotion) {
    const rows = [...tailDemo.querySelectorAll<HTMLElement>('[data-log]')]
    replay(tailDemo, 3, async () => {
      mark(rows, 'data-hidden', true)
      await sleep(500)
      await reveal(rows, 140)
      await sleep(3200)
    })
  }

  const filterDemo = document.querySelector('[data-filter-demo]')
  if (filterDemo && !reduceMotion) {
    const lines = [...filterDemo.querySelectorAll<HTMLElement>('[data-log]')]
    const dropped = lines.filter(line => line.dataset.dropped !== undefined)
    const chip = filterDemo.querySelector('[data-filter-chip]')
    replay(filterDemo, 3, async () => {
      mark(dropped, 'data-dropped', false)
      mark(lines, 'data-hidden', true)
      await sleep(500)
      await reveal(lines, 140)
      await sleep(800)
      light(chip, true)
      mark(dropped, 'data-dropped', true)
      await sleep(600)
      light(chip, false)
      await sleep(2800)
    })
  }

  const samplingDemo = document.querySelector('[data-sampling-demo]')
  if (samplingDemo && !reduceMotion) {
    const sampled = [...samplingDemo.querySelectorAll('[data-sampled]')]
    const headChip = samplingDemo.querySelector('[data-head-chip]')
    const tailChip = samplingDemo.querySelector('[data-tail-chip]')
    replay(samplingDemo, 3, async () => {
      await sleep(600)
      light(headChip, true)
      mark(sampled, 'data-dropped', true)
      await sleep(1000)
      light(headChip, false)
      await sleep(700)
      light(tailChip, true)
      mark(sampled, 'data-dropped', false)
      await sleep(1000)
      light(tailChip, false)
      await sleep(2400)
    })
  }

  const enrichersDemo = document.querySelector('[data-enrichers-demo]')
  if (enrichersDemo && !reduceMotion) {
    const fields = [
      ...enrichersDemo.querySelectorAll<HTMLElement>('tbody tr')
    ]
    const chip = enrichersDemo.querySelector('[data-enrichers-chip]')
    mark(fields, 'data-hidden', true)
    replay(enrichersDemo, 1, async () => {
      light(chip, true)
      await sleep(200)
      await reveal(fields, 50)
      await sleep(450)
      light(chip, false)
    })
  }

  const rotation = document.querySelector('[data-rotation]')
  const files = rotation?.querySelector<HTMLElement>('[data-files]')
  if (rotation && files && !reduceMotion) {
    const CAP_MEGABYTES = 10
    const FRESH_MEGABYTES = 0.1
    // Logixlysia renames a full file to `<path>.<YYYY-MM-DD-HH-MM-SS-SSS>-<hrtime>`
    // and appends `.gz` once it is compressed (output/rotation-manager.ts).
    const archives = [
      { gzMegabytes: 1.2, suffix: '2026-07-21-11-02-44-918-70966918077342' },
      { gzMegabytes: 1.1, suffix: '2026-07-21-12-10-37-055-75039055630481' },
      { gzMegabytes: 1.3, suffix: '2026-07-21-13-21-58-430-79320430918764' }
    ]
    const staticRows = [...files.children].map(row => row.cloneNode(true))
    const livePath =
      files.querySelector('[data-file="live"] [data-file-name]')?.textContent
        ?.trim() ?? ''
    let liveMegabytes = Number(
      files
        .querySelector('[data-file="live"] [data-file-size]')
        ?.textContent?.trim()
        .replace(' MB', '')
    )

    const setSize = (row: Element, megabytes: number) => {
      const size = row.querySelector('[data-file-size]')
      const bar = row.querySelector<HTMLElement>('[data-file-bar]')
      if (size) {
        size.textContent = `${megabytes.toFixed(1)} MB`
      }
      if (bar) {
        bar.style.scale = `${megabytes / CAP_MEGABYTES} 1`
      }
    }
    const grow = (row: Element) =>
      new Promise<void>(resolve => {
        const tick = () => {
          setSize(row, Math.min(liveMegabytes, CAP_MEGABYTES))
          if (liveMegabytes >= CAP_MEGABYTES) {
            resolve()
            return
          }
          liveMegabytes += 0.3
          setTimeout(tick, 120)
        }
        tick()
      })

    // The rows below slide down one slot (transform only) to make room for
    // the new live file, so the list keeps its height.
    const shiftIn = (fresh: HTMLElement, rows: HTMLElement[]) => {
      const before = rows.map(row => row.getBoundingClientRect().top)
      files.prepend(fresh)
      const offsets = rows.map(
        (row, index) => (before[index] ?? 0) - row.getBoundingClientRect().top
      )
      for (const [index, row] of rows.entries()) {
        row.style.transition = 'none'
        row.style.translate = `0 ${offsets[index]}px`
      }
      files.getBoundingClientRect()
      for (const row of rows) {
        row.style.transition = ''
        row.style.translate = ''
      }
    }

    const rotate = async (index: number) => {
      const archive = archives[index]
      const rows = [...files.querySelectorAll<HTMLElement>('[data-file]')]
      const live = rows.at(0)
      const oldest = rows.at(-1)
      if (!(archive && live && oldest)) {
        return
      }
      await grow(live)
      await sleep(300)
      oldest.dataset.file = 'exiting'
      await sleep(150)
      oldest.remove()
      const fresh = live.cloneNode(true)
      if (!(fresh instanceof HTMLElement)) {
        return
      }
      liveMegabytes = FRESH_MEGABYTES
      setSize(fresh, liveMegabytes)
      fresh.dataset.file = 'entering'
      shiftIn(fresh, rows.slice(0, -1))
      live.dataset.file = 'archived'
      live.querySelector('[data-live-badge]')?.remove()
      setName(live, `${livePath}.${archive.suffix}`)
      await sleep(120)
      fresh.dataset.file = 'live'
      await sleep(780)
      setName(live, `${livePath}.${archive.suffix}.gz`)
      setSize(live, archive.gzMegabytes)
      await sleep(1600)
    }

    const play = async () => {
      await replay(rotation, archives.length, rotate)
      files.dataset.resetting = ''
      await sleep(150)
      files.replaceChildren(...staticRows)
      delete files.dataset.resetting
    }
    play()
  }
</script>
