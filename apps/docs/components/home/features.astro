]

const samplingRows = [
  {
    barCls: c.barMint,
    barPct: 3,
    duration: '4ms',
    durationCls: c.mint,
    method: 'GET',
    methodCls: c.mint,
    path: '/api/items',
    sampled: true,
    status: '200',
    statusCls: c.mint,
    tag: 'replayed',
    tagCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '3ms',
    durationCls: c.mint,
    method: 'GET',
    methodCls: c.mint,
    path: '/api/items/7',
    sampled: true,
    status: '200',
    statusCls: c.mint,
    tag: 'replayed',
    tagCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 4,
    duration: '6ms',
    durationCls: c.mint,
    method: 'GET',
    methodCls: c.mint,
    path: '/api/cart',
    sampled: true,
    status: '200',
    statusCls: c.mint,
    tag: 'replayed',
    tagCls: c.mint
