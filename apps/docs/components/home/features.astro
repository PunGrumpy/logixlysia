---
// Demo data lives here so every table row keeps its colors next to its
// values; the dual-theme palette below is shared with demo.astro.
import ContextRow from './context-row.astro'
import FieldRow from './field-row.astro'
import FileRow from './file-row.astro'
import FilterRow from './filter-row.astro'
import SamplingRow from './sampling-row.astro'
import SectionLabel from './section-label.astro'

// Dual-mode terminal palette: muted ink colors in light mode, vesper in dark.
const c = {
  barMint: 'bg-[#067647] dark:bg-[#99ffe4]',
  barOrange: 'bg-[#B26A00] dark:bg-[#ffc799]',
  barRed: 'bg-[#C9303C] dark:bg-[#ff8080]',
  blue: 'text-[#0550AE] dark:text-[#a5d6ff]',
  bold: 'font-semibold',
  fg: 'text-[#2D2D2D] dark:text-[#DADADA]',
  foxInfo: 'rounded-sm bg-[#0550AE]/10 dark:bg-[#a5d6ff]/15',
  mint: 'text-[#067647] dark:text-[#99ffe4]',
  muted: 'text-black/45 dark:text-white/40',
  orange: 'text-[#B26A00] dark:text-[#ffc799]',
  red: 'text-[#C9303C] dark:text-[#ff8080]'
}

const th =
  'border-[#EBEBEB] border-b pb-2 pr-6 text-left font-normal text-[11px] text-muted-foreground uppercase tracking-[0.08em] transition-opacity duration-300 dark:border-white/8'

// 01 · The full access log record: every column the plugin captures.
const contextRows = [
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '3ms',
    durationCls: c.mint,
    ip: '10.0.0.42',
    method: 'GET',
    methodCls: c.mint,
    path: '/',
    status: '200',
    statusCls: c.mint,
    time: '10:24:31.804'
  },
  {
    barCls: c.barMint,
    barPct: 6,
    duration: '38ms',
    durationCls: c.mint,
    ip: '10.0.0.17',
    method: 'POST',
    methodCls: c.blue,
    path: '/auth/login',
    status: '201',
    statusCls: c.mint,
    time: '10:24:32.108'
  },
  {
    barCls: c.barOrange,
    barPct: 55,
    duration: '613ms',
    durationCls: c.orange,
    ip: '172.16.4.9',
    method: 'GET',
    methodCls: c.mint,
    path: '/reports',
    status: '200',
    statusCls: c.mint,
    time: '10:24:33.412'
  },
  {
    barCls: c.barRed,
    barPct: 92,
    duration: '1.2s',
    durationCls: c.red,
    ip: '10.0.0.42',
    method: 'GET',
    methodCls: c.mint,
    path: '/export',
    status: '200',
    statusCls: c.mint,
    time: '10:24:34.001'
  },
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '2ms',
    durationCls: c.mint,
    errorRow: true,
    ip: '203.0.113.5',
    method: 'GET',
    methodCls: c.mint,
    path: '/crash',
    status: '500',
    statusCls: c.red,
    time: '10:24:35.219'
  }
]

// 02 · The filter keeps warnings and errors; the rest dims away.
const filterRows = [
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '1ms',
    durationCls: c.mint,
    kept: false,
    method: 'GET',
    methodCls: c.mint,
    path: '/health',
    status: '200',
    statusCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 3,
    duration: '3ms',
    durationCls: c.mint,
    kept: false,
    method: 'GET',
    methodCls: c.mint,
    path: '/',
    status: '200',
    statusCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '1ms',
    durationCls: c.mint,
    kept: true,
    method: 'GET',
    methodCls: c.mint,
    path: '/favicon.ico',
    status: '404',
    statusCls: c.orange
  },
  {
    barCls: c.barMint,
    barPct: 8,
    duration: '38ms',
    durationCls: c.mint,
    kept: false,
    method: 'POST',
    methodCls: c.blue,
    path: '/auth/login',
    status: '201',
    statusCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '2ms',
    durationCls: c.mint,
    errorRow: true,
    kept: true,
    method: 'GET',
    methodCls: c.mint,
    path: '/crash',
    status: '500',
    statusCls: c.red
  }
]

// 03 · Head sampling dims the routine rows; the 500 replays the request.
const samplingRows = [
  {
    barCls: c.barMint,
    barPct: 3,
    duration: '4ms',
    durationCls: c.mint,
    method: 'GET',
    methodCls: c.mint,
    path: '/api/items',
    sampled: true,
    status: '200',
    statusCls: c.mint,
    tag: 'replayed',
    tagCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '3ms',
    durationCls: c.mint,
    method: 'GET',
    methodCls: c.mint,
    path: '/api/items/7',
    sampled: true,
    status: '200',
    statusCls: c.mint,
    tag: 'replayed',
    tagCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 4,
    duration: '6ms',
    durationCls: c.mint,
    method: 'GET',
    methodCls: c.mint,
    path: '/api/cart',
    sampled: true,
    status: '200',
    statusCls: c.mint,
    tag: 'replayed',
    tagCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 12,
    duration: '87ms',
    durationCls: c.mint,
    errorRow: true,
    method: 'POST',
    methodCls: c.blue,
    path: '/checkout',
    status: '500',
    statusCls: c.red,
    tag: 'tail match',
    tagCls: c.red
  }
]

// 04 · Fields the enrichers attach to the GET /reports request.
const enricherFields = [
  { cls: c.blue, name: 'trace_id', value: '4bf92f3577b34da6a3ce929d0e0e4736' },
  { name: 'geo.city', value: 'Berlin' },
  { name: 'geo.country', value: 'DE' },
  { name: 'ua.browser', value: 'Chrome' },
  { name: 'ua.device', value: 'desktop' }
]

// 05 · The meter shows each file against the 10 MB rotation cap.
const files = [
  { live: true, name: 'logs/api-2026-07-21.log', pct: 21, size: '2.1 MB' },
  { live: false, name: 'logs/api-2026-07-20.log', pct: 100, size: '10.0 MB' },
  { live: false, name: 'logs/api-2026-07-19.log.gz', pct: 12, size: '1.2 MB' }
]
---

<section class="mx-auto grid w-full max-w-5xl gap-16 sm:gap-24">
  <!-- 01 · Request context -->
  <div class="t-stagger grid gap-8" data-reveal>
    <div class="t-stagger-line grid justify-items-start gap-4">
      <SectionLabel name="Request context">
        <svg
          aria-hidden="true"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
        </svg>
      </SectionLabel>
      <div class="grid w-full gap-4 lg:grid-cols-2 lg:gap-12">
        <h2
          class="text-balance font-medium text-[25px] text-foreground leading-[130%] lg:text-[32px]"
        >
          See every request, end to end
        </h2>
        <div
          class="grid justify-items-start gap-1 lg:max-w-md lg:justify-self-end"
        >
          <p
            class="text-pretty text-[15px] text-muted-foreground leading-[160%] lg:text-[17px]"
          >
            Method, path, status, duration, and client IP land on one readable
            line — captured automatically for every request, with no wrappers
            and no middleware chains.
          </p>
          <a
            class="group -my-2.5 py-2.5 font-medium text-[15px] text-foreground transition-colors hover:text-muted-foreground"
            href="/docs/features/request-context"
          >
            Explore request context
            <span
              aria-hidden="true"
              class="inline-block transition-[translate] group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
      </div>
    </div>
    <div
      class="t-stagger-line t-stagger-line--2 min-w-0 rounded-2xl bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.06),0_1px_2px_-1px_rgb(0_0_0/0.06),0_2px_4px_0_rgb(0_0_0/0.04)] dark:bg-[#131313] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.08)]"
      data-tail
    >
      <div
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-[#EBEBEB] border-b p-4 dark:border-white/8"
      >
        <span class="font-medium text-[#6E6E6E] text-sm dark:text-[#888888]">
          Access log
        </span>
        <span
          class="whitespace-nowrap rounded-full px-2 py-0.5 font-mono text-[#2D2D2D] text-[11px] shadow-[0_0_0_1px_rgb(0_0_0/0.08)] dark:text-[#DADADA] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.1)]"
        >
          .use(logixlysia())
        </span>
      </div>
      <div class="overflow-x-auto px-3 py-5">
        <table
          aria-label="Example access log: five requests, each with its time, method, path, status, duration, and client IP"
          class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
        >
          <thead>
            <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
              <th class={th} scope="col">Time</th>
              <th class={th} scope="col">Method</th>
              <th class={th} scope="col">Path</th>
              <th class={th} scope="col">Status</th>
              <th class={th} scope="col">Duration</th>
              <th scope="col" class:list={[th, 'pr-0']}>IP</th>
            </tr>
          </thead>
          <tbody>
            {contextRows.map(row => (
              <ContextRow {...row} />
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 02 · Filtering -->
  <div class="t-stagger grid gap-8" data-reveal>
    <div class="t-stagger-line grid justify-items-start gap-4">
      <SectionLabel name="Filtering">
        <svg
          aria-hidden="true"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"></path>
        </svg>
      </SectionLabel>
      <div class="grid w-full gap-4 lg:grid-cols-2 lg:gap-12">
        <h2
          class="text-balance font-medium text-[25px] text-foreground leading-[130%] lg:text-[32px]"
        >
          Keep the noise out
        </h2>
        <div
          class="grid justify-items-start gap-1 lg:max-w-md lg:justify-self-end"
        >
          <p
            class="text-pretty text-[15px] text-muted-foreground leading-[160%] lg:text-[17px]"
          >
            Filter by level, HTTP method, or status code. Health checks and
            favicons fade away — warnings and errors stay loud.
          </p>
          <a
            class="group -my-2.5 py-2.5 font-medium text-[15px] text-foreground transition-colors hover:text-muted-foreground"
            href="/docs/features/filtering"
          >
            Explore filtering
            <span
              aria-hidden="true"
              class="inline-block transition-[translate] group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
      </div>
    </div>
    <div
      class="t-stagger-line t-stagger-line--2 min-w-0 rounded-2xl bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.06),0_1px_2px_-1px_rgb(0_0_0/0.06),0_2px_4px_0_rgb(0_0_0/0.04)] dark:bg-[#131313] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.08)]"
      data-filter-demo
    >
      <div
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-[#EBEBEB] border-b p-4 dark:border-white/8"
      >
        <span class="font-medium text-[#6E6E6E] text-sm dark:text-[#888888]">
          Console
        </span>
        <span
          class="whitespace-nowrap rounded-full px-2 py-0.5 font-mono text-[#2D2D2D] text-[11px] shadow-[0_0_0_1px_rgb(0_0_0/0.08)] transition-[background-color] duration-300 dark:text-[#DADADA] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.1)]"
          data-filter-chip
        >
          filter: &lbrace; level: ['warn', 'error'] &rbrace;
        </span>
      </div>
      <div class="overflow-x-auto px-3 py-5">
        <table
          aria-label="Example filter config keeping only warnings and errors; filtered-out request logs appear dimmed"
          class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
        >
          <thead>
            <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
              <th class={th} scope="col">Method</th>
              <th class={th} scope="col">Path</th>
              <th class={th} scope="col">Status</th>
              <th class={th} scope="col">Duration</th>
            </tr>
          </thead>
          <tbody>
            {filterRows.map(row => (
              <FilterRow {...row} />
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 03 · Sampling -->
  <div class="t-stagger grid gap-8" data-reveal>
    <div class="t-stagger-line grid justify-items-start gap-4">
      <SectionLabel badge="New" name="Sampling">
        <svg
          aria-hidden="true"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path d="M19 5L5 19"></path>
          <circle cx="6.5" cy="6.5" r="2.5"></circle>
          <circle cx="17.5" cy="17.5" r="2.5"></circle>
        </svg>
      </SectionLabel>
      <div class="grid w-full gap-4 lg:grid-cols-2 lg:gap-12">
        <h2
          class="text-balance font-medium text-[25px] text-foreground leading-[130%] lg:text-[32px]"
        >
          Keep the bill flat
        </h2>
        <div
          class="grid justify-items-start gap-1 lg:max-w-md lg:justify-self-end"
        >
          <p
            class="text-pretty text-[15px] text-muted-foreground leading-[160%] lg:text-[17px]"
          >
            Head sampling keeps a percentage of high-volume levels. Tail
            sampling replays the dropped lines the moment a request errors or
            runs slow — routine traffic costs almost nothing, interesting
            requests stay complete.
          </p>
          <a
            class="group -my-2.5 py-2.5 font-medium text-[15px] text-foreground transition-colors hover:text-muted-foreground"
            href="/docs/features/sampling"
          >
            Explore sampling
            <span
              aria-hidden="true"
              class="inline-block transition-[translate] group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
      </div>
    </div>
    <div
      class="t-stagger-line t-stagger-line--2 min-w-0 rounded-2xl bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.06),0_1px_2px_-1px_rgb(0_0_0/0.06),0_2px_4px_0_rgb(0_0_0/0.04)] dark:bg-[#131313] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.08)]"
      data-sampling-demo
    >
      <div
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-[#EBEBEB] border-b p-4 dark:border-white/8"
      >
        <span class="font-medium text-[#6E6E6E] text-sm dark:text-[#888888]">
          Console
        </span>
        <div class="flex flex-wrap gap-1.5">
          <span
            class="whitespace-nowrap rounded-full px-2 py-0.5 font-mono text-[#2D2D2D] text-[11px] shadow-[0_0_0_1px_rgb(0_0_0/0.08)] transition-[background-color] duration-300 dark:text-[#DADADA] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.1)]"
            data-head-chip
          >
            head: &lbrace; INFO: 10 &rbrace;
          </span>
          <span
            class="whitespace-nowrap rounded-full px-2 py-0.5 font-mono text-[#2D2D2D] text-[11px] shadow-[0_0_0_1px_rgb(0_0_0/0.08)] transition-[background-color] duration-300 dark:text-[#DADADA] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.1)]"
            data-tail-chip
          >
            tail: &lbrace; status: 400 &rbrace;
          </span>
        </div>
      </div>
      <div class="overflow-x-auto px-3 py-5">
        <table
          aria-label="Example sampling config: routine request logs dim as head sampling drops them, then a 500 response replays every line from that request"
          class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
        >
          <thead>
            <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
              <th class={th} scope="col">Method</th>
              <th class={th} scope="col">Path</th>
              <th class={th} scope="col">Status</th>
              <th class={th} scope="col">Duration</th>
              <th scope="col" class:list={[th, 'pr-0 text-right']}>Sampling</th>
            </tr>
          </thead>
          <tbody>
            {samplingRows.map(row => (
              <SamplingRow {...row} />
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 04 · Enrichers -->
  <div class="t-stagger grid gap-8" data-reveal>
    <div class="t-stagger-line grid justify-items-start gap-4">
      <SectionLabel badge="New" name="Enrichers">
        <svg
          aria-hidden="true"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 8v8M8 12h8"></path>
        </svg>
      </SectionLabel>
      <div class="grid w-full gap-4 lg:grid-cols-2 lg:gap-12">
        <h2
          class="text-balance font-medium text-[25px] text-foreground leading-[130%] lg:text-[32px]"
        >
          Add context once, see it everywhere
        </h2>
        <div
          class="grid justify-items-start gap-1 lg:max-w-md lg:justify-self-end"
        >
          <p
            class="text-pretty text-[15px] text-muted-foreground leading-[160%] lg:text-[17px]"
          >
            Enrichers contribute fields to every request — trace ids from the
            traceparent header, geo from your platform's headers, parsed user
            agents. Set them up once and the fields reach the console, files,
            and every adapter.
          </p>
          <a
            class="group -my-2.5 py-2.5 font-medium text-[15px] text-foreground transition-colors hover:text-muted-foreground"
            href="/docs/features/enrichers"
          >
            Explore enrichers
            <span
              aria-hidden="true"
              class="inline-block transition-[translate] group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
      </div>
    </div>
    <div
      class="t-stagger-line t-stagger-line--2 min-w-0 rounded-2xl bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.06),0_1px_2px_-1px_rgb(0_0_0/0.06),0_2px_4px_0_rgb(0_0_0/0.04)] dark:bg-[#131313] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.08)]"
    >
      <div
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-[#EBEBEB] border-b p-4 dark:border-white/8"
      >
        <span class="font-medium text-[#6E6E6E] text-sm dark:text-[#888888]">
          Enriched request
        </span>
        <span
          class="whitespace-nowrap rounded-full px-2 py-0.5 font-mono text-[#2D2D2D] text-[11px] shadow-[0_0_0_1px_rgb(0_0_0/0.08)] dark:text-[#DADADA] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.1)]"
        >
          enrichers: [traceparentEnricher(), geoEnricher()]
        </span>
      </div>
      <div class="overflow-x-auto px-3 py-5">
        <table
          aria-label="Example enricher config: a table of fields attached to one request — trace id, geo city and country, browser, and device"
          class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
        >
          <thead>
            <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
              <th class={th} scope="col">Field</th>
              <th class={th} scope="col">Value</th>
            </tr>
          </thead>
          <tbody>
            {enricherFields.map(field => (
              <FieldRow cls={field.cls} name={field.name} value={field.value} />
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 05 · File rotation -->
  <div class="t-stagger grid gap-8" data-reveal>
    <div class="t-stagger-line grid justify-items-start gap-4">
      <SectionLabel name="File rotation">
        <svg
          aria-hidden="true"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path
            d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
          ></path>
          <path d="M14 2v6h6"></path>
        </svg>
      </SectionLabel>
      <div class="grid w-full gap-4 lg:grid-cols-2 lg:gap-12">
        <h2
          class="text-balance font-medium text-[25px] text-foreground leading-[130%] lg:text-[32px]"
        >
          Outlive the terminal
        </h2>
        <div
          class="grid justify-items-start gap-1 lg:max-w-md lg:justify-self-end"
        >
          <p
            class="text-pretty text-[15px] text-muted-foreground leading-[160%] lg:text-[17px]"
          >
            Write logs to disk with size- and time-based rotation built in —
            yesterday's file compresses and rotates away on its own.
          </p>
          <a
            class="group -my-2.5 py-2.5 font-medium text-[15px] text-foreground transition-colors hover:text-muted-foreground"
            href="/docs/features/file-logging"
          >
            Explore file logging
            <span
              aria-hidden="true"
              class="inline-block transition-[translate] group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
      </div>
    </div>
    <div
      aria-label="Example rotation config: the live log file's size meter grows to the 10 MB cap, then rotates while older files compress"
      class="t-stagger-line t-stagger-line--2 min-w-0 rounded-2xl bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.06),0_1px_2px_-1px_rgb(0_0_0/0.06),0_2px_4px_0_rgb(0_0_0/0.04)] dark:bg-[#131313] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.08)]"
      data-rotation
      role="img"
    >
      <div
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-[#EBEBEB] border-b p-4 dark:border-white/8"
      >
        <span class="font-medium text-[#6E6E6E] text-sm dark:text-[#888888]">
          Log directory
        </span>
        <span
          class="whitespace-nowrap rounded-full px-2 py-0.5 font-mono text-[#2D2D2D] text-[11px] shadow-[0_0_0_1px_rgb(0_0_0/0.08)] dark:text-[#DADADA] dark:shadow-[0_0_0_1px_rgb(255_255_255/0.1)]"
        >
          rotation: &lbrace; size: '10m', interval: '1d' &rbrace;
        </span>
      </div>
      <div
        class="grid gap-1 overflow-x-auto p-5 font-mono text-[0.8rem] leading-relaxed"
      >
        {files.map(file => (
          <FileRow
            live={file.live}
            name={file.name}
            pct={file.pct}
            size={file.size}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const sleep = (ms: number) => new Promise(resolve => setTimeout(resolve, ms))

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches

  // Resolves immediately while `el` is on screen; otherwise waits for it.
  const visibilityGate = (el: Element) => {
    let visible = false
    let onVisible: (() => void) | undefined
    new IntersectionObserver(
      entries => {
        visible = entries.some(entry => entry.isIntersecting)
        if (visible && onVisible) {
          onVisible()
          onVisible = undefined
        }
      },
      { threshold: 0.35 }
    ).observe(el)
    return () =>
      visible
        ? Promise.resolve()
        : new Promise<void>(resolve => {
            onVisible = resolve
          })
  }

  // 01 · Tail the access log: rows arrive one by one, like a live stream.
  const tailDemo = document.querySelector('[data-tail]')
  if (tailDemo && !reduceMotion) {
    const rows = [...tailDemo.querySelectorAll<HTMLElement>('[data-log]')]
    const waitUntilVisible = visibilityGate(tailDemo)
    // setTimeout chain instead of an awaited loop: rows reveal one by one.
    const revealRows = () =>
      new Promise<void>(resolve => {
        let index = 0
        const tick = () => {
          const row = rows[index]
          if (!row) {
            resolve()
            return
          }
          index += 1
          row.classList.remove('opacity-0')
          setTimeout(tick, 220)
        }
        tick()
      })
    const round = async () => {
      await waitUntilVisible()
      for (const row of rows) {
        row.classList.add('opacity-0')
      }
      await sleep(500)
      await revealRows()
      await sleep(3200)
    }
    // Bounded replay (WCAG 2.2.2): stop after a few rounds instead of looping
    // forever; the resting state matches the static markup.
    let rounds = 0
    const loop = () => {
      round().then(() => {
        rounds += 1
        if (rounds < 3) {
          loop()
        }
      })
    }
    loop()
  }

  // 02 · Replay the raw stream, then apply the filter and dim the noise.
  const filterDemo = document.querySelector('[data-filter-demo]')
  if (filterDemo && !reduceMotion) {
    const lines = [...filterDemo.querySelectorAll<HTMLElement>('[data-log]')]
    const chip = filterDemo.querySelector<HTMLElement>('[data-filter-chip]')
    const waitUntilVisible = visibilityGate(filterDemo)
    // setTimeout chain instead of an awaited loop: lines reveal one by one.
    const revealLines = () =>
      new Promise<void>(resolve => {
        let index = 0
        const tick = () => {
          const line = lines[index]
          if (!line) {
            resolve()
            return
          }
          index += 1
          line.classList.remove('opacity-0')
          setTimeout(tick, 180)
        }
        tick()
      })
    const round = async () => {
      await waitUntilVisible()
      for (const line of lines) {
        line.classList.add('opacity-0')
        line.classList.remove('opacity-35')
      }
      await sleep(500)
      await revealLines()
      await sleep(800)
      chip?.classList.add('bg-black/5', 'dark:bg-white/10')
      for (const line of lines) {
        if (line.dataset.kept === undefined) {
          line.classList.add('opacity-35')
        }
      }
      await sleep(600)
      chip?.classList.remove('bg-black/5', 'dark:bg-white/10')
      await sleep(2800)
    }
    let rounds = 0
    const loop = () => {
      round().then(() => {
        rounds += 1
        if (rounds < 3) {
          loop()
        }
      })
    }
    loop()
  }

  // 03 · Head sampling dims the routine rows, then the 500 replays them.
  const samplingDemo = document.querySelector('[data-sampling-demo]')
  if (samplingDemo && !reduceMotion) {
    const sampled = [
      ...samplingDemo.querySelectorAll<HTMLElement>('[data-sampled]')
    ]
    const headChip = samplingDemo.querySelector<HTMLElement>('[data-head-chip]')
    const tailChip = samplingDemo.querySelector<HTMLElement>('[data-tail-chip]')
    const waitUntilVisible = visibilityGate(samplingDemo)
    const round = async () => {
      await waitUntilVisible()
      await sleep(600)
      headChip?.classList.add('bg-black/5', 'dark:bg-white/10')
      for (const row of sampled) {
        row.classList.add('opacity-35')
      }
      await sleep(1000)
      headChip?.classList.remove('bg-black/5', 'dark:bg-white/10')
      await sleep(700)
      tailChip?.classList.add('bg-black/5', 'dark:bg-white/10')
      for (const row of sampled) {
        row.classList.remove('opacity-35')
      }
      await sleep(1000)
      tailChip?.classList.remove('bg-black/5', 'dark:bg-white/10')
      await sleep(2400)
    }
    let rounds = 0
    const loop = () => {
      round().then(() => {
        rounds += 1
        if (rounds < 3) {
          loop()
        }
      })
    }
    loop()
  }

  // 05 · The live file grows until the size threshold, flashes, and rotates.
  const rotation = document.querySelector('[data-rotation]')
  if (rotation && !reduceMotion) {
    const row = rotation.querySelector<HTMLElement>('[data-live-row]')
    const size = rotation.querySelector<HTMLElement>('[data-live-size]')
    const bar = rotation.querySelector<HTMLElement>('[data-live-bar]')
    const waitUntilVisible = visibilityGate(rotation)
    if (row && size && bar) {
      // setTimeout chain instead of an awaited loop: the size ticks upward.
      const growFile = () =>
        new Promise<void>(resolve => {
          let megabytes = 0.1
          const tick = () => {
            if (megabytes >= 10) {
              resolve()
              return
            }
            size.textContent = `${megabytes.toFixed(1)} MB`
            bar.style.width = `${megabytes * 10}%`
            megabytes += 0.3
            setTimeout(tick, 120)
          }
          tick()
        })
      const round = async () => {
        await waitUntilVisible()
        await growFile()
        size.textContent = '10.0 MB'
        bar.style.width = '100%'
        row.classList.add('bg-[#067647]/10', 'dark:bg-[#99ffe4]/10')
        await sleep(700)
        row.classList.remove('bg-[#067647]/10', 'dark:bg-[#99ffe4]/10')
      }
      const initialSize = size.textContent
      const initialWidth = bar.style.width
      let rounds = 0
      const loop = () => {
        round().then(() => {
          rounds += 1
          if (rounds < 3) {
            loop()
            return
          }
          size.textContent = initialSize
          bar.style.width = initialWidth
        })
      }
      loop()
    }
  }
</script>
