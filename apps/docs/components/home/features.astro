  },
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '2ms',
    durationCls: c.mint,
    errorRow: true,
    ip: '203.0.113.5',
    method: 'GET',
    methodCls: c.mint,
    path: '/crash',
    status: '500',
    statusCls: c.red,
    time: '10:24:35.219'
