]

const enricherFields = [
  { cls: c.blue, name: 'trace_id', value: '4bf92f3577b34da6a3ce929d0e0e4736' },
  { name: 'geo.city', value: 'Berlin' },
  { name: 'geo.country', value: 'DE' },
  { name: 'ua.browser', value: 'Chrome' },
  { name: 'ua.device', value: 'desktop' }
]

const files = [
  { live: true, name: 'logs/api-2026-07-21.log', pct: 21, size: '2.1 MB' },
  { live: false, name: 'logs/api-2026-07-20.log', pct: 100, size: '10.0 MB' },
  { live: false, name: 'logs/api-2026-07-19.log.gz', pct: 12, size: '1.2 MB' }
]
---

<section aria-labelledby="hp-context" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="Request context"
      href="/docs/features/request-context"
      id="hp-context"
      linkLabel="Explore request context"
      title="See every request, end to end"
    >
      Method, path, status, duration, and client IP land on one readable line —
      captured automatically for every request, with no wrappers and no
      middleware chains.
    </SectionHeading>
    <FeatureFigure data-tail label="Access log">
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset" slot="chips">.use(logixlysia())</span>
      <table
        aria-label="Example access log: five requests, each with its time, method, path, status, duration, and client IP"
        class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
      >
        <thead>
          <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
            <th class={th} scope="col">Time</th>
            <th class={th} scope="col">Method</th>
            <th class={th} scope="col">Path</th>
            <th class={th} scope="col">Status</th>
            <th class={th} scope="col">Duration</th>
            <th scope="col" class:list={[th, 'pr-0']}>IP</th>
          </tr>
        </thead>
        <tbody>
          {contextRows.map(row => (
            <ContextRow {...row} />
          ))}
        </tbody>
      </table>
    </FeatureFigure>
  </div>
</section>

<section aria-labelledby="hp-filtering" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="Filtering"
      href="/docs/features/filtering"
      id="hp-filtering"
      linkLabel="Explore filtering"
      title="Keep the noise out"
    >
      Filter by level, HTTP method, or status code. Health checks and favicons
      fade away — warnings and errors stay loud.
    </SectionHeading>
    <FeatureFigure data-filter-demo label="Console">
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset" data-filter-chip slot="chips">
        filter: &lbrace; level: ['warn', 'error'] &rbrace;
      </span>
      <table
        aria-label="Example filter config keeping only warnings and errors; filtered-out request logs appear dimmed"
        class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
      >
        <thead>
          <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
            <th class={th} scope="col">Method</th>
            <th class={th} scope="col">Path</th>
            <th class={th} scope="col">Status</th>
            <th class={th} scope="col">Duration</th>
          </tr>
        </thead>
        <tbody>
          {filterRows.map(row => (
            <FilterRow {...row} />
          ))}
        </tbody>
      </table>
    </FeatureFigure>
  </div>
</section>

<section aria-labelledby="hp-sampling" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="Sampling"
      href="/docs/features/sampling"
      id="hp-sampling"
      linkLabel="Explore sampling"
      tag="New"
      title="Keep the bill flat"
    >
      Head sampling keeps a percentage of high-volume levels. Tail sampling
      replays the dropped lines the moment a request errors or runs slow —
      routine traffic costs almost nothing, interesting requests stay complete.
    </SectionHeading>
    <FeatureFigure data-sampling-demo label="Console">
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset" data-head-chip slot="chips">
        head: &lbrace; INFO: 10 &rbrace;
      </span>
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset" data-tail-chip slot="chips">
        tail: &lbrace; status: 400 &rbrace;
      </span>
      <table
        aria-label="Example sampling config: routine request logs dim as head sampling drops them, then a 500 response replays every line from that request"
        class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
      >
        <thead>
          <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
            <th class={th} scope="col">Method</th>
            <th class={th} scope="col">Path</th>
            <th class={th} scope="col">Status</th>
            <th class={th} scope="col">Duration</th>
            <th scope="col" class:list={[th, 'pr-0 text-right']}>Sampling</th>
          </tr>
        </thead>
        <tbody>
          {samplingRows.map(row => (
            <SamplingRow {...row} />
          ))}
        </tbody>
      </table>
    </FeatureFigure>
  </div>
</section>

<section aria-labelledby="hp-enrichers" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="Enrichers"
      href="/docs/features/enrichers"
      id="hp-enrichers"
      linkLabel="Explore enrichers"
      tag="New"
      title="Add context once, see it everywhere"
    >
      Enrichers contribute fields to every request — trace ids from the
      traceparent header, geo from your platform's headers, parsed user agents.
      Set them up once and the fields reach the console, files, and every
      adapter.
    </SectionHeading>
    <FeatureFigure label="Enriched request">
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset" slot="chips">
        enrichers: [traceparentEnricher(), geoEnricher()]
      </span>
      <table
        aria-label="Example enricher config: a table of fields attached to one request — trace id, geo city and country, browser, and device"
        class="w-full border-separate border-spacing-0 font-mono text-[0.8rem] leading-relaxed"
      >
        <thead>
          <tr class="[&>th:first-child]:pl-2 [&>th:last-child]:pr-2">
            <th class={th} scope="col">Field</th>
            <th class={th} scope="col">Value</th>
          </tr>
        </thead>
        <tbody>
          {enricherFields.map(field => (
            <FieldRow cls={field.cls} name={field.name} value={field.value} />
          ))}
        </tbody>
      </table>
    </FeatureFigure>
  </div>
</section>

<section aria-labelledby="hp-files" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <SectionHeading
      eyebrow="File rotation"
      href="/docs/features/file-logging"
      id="hp-files"
      linkLabel="Explore file logging"
      title="Outlive the terminal"
    >
      Write logs to disk with size- and time-based rotation built in —
      yesterday's file compresses and rotates away on its own.
    </SectionHeading>
    <FeatureFigure
      aria-label="Example rotation config: the live log file's size meter grows to the 10 MB cap, then rotates while older files compress"
      data-rotation
      label="Log directory"
      role="img"
    >
      <span class="whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-[11px] text-foreground ring-1 ring-border ring-inset" slot="chips">
        rotation: &lbrace; size: '10m', interval: '1d' &rbrace;
      </span>
      <div class="grid gap-1 px-2 font-mono text-[0.8rem] leading-relaxed">
        {files.map(file => (
          <FileRow
            live={file.live}
            name={file.name}
            pct={file.pct}
            size={file.size}
          />
        ))}
      </div>
    </FeatureFigure>
  </div>
</section>

<script>
  const sleep = (ms: number): Promise<void> =>
    new Promise(resolve => {
      setTimeout(resolve, ms)
    })

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches

  const visibilityGate = (el: Element) => {
    let visible = false
    let onVisible: (() => void) | undefined
    new IntersectionObserver(
      entries => {
        visible = entries.some(entry => entry.isIntersecting)
        if (visible && onVisible) {
          onVisible()
          onVisible = undefined
        }
      },
      { threshold: 0.35 }
    ).observe(el)
    return () =>
      visible
        ? Promise.resolve()
        : new Promise<void>(resolve => {
            onVisible = resolve
          })
  }

  const tailDemo = document.querySelector('[data-tail]')
  if (tailDemo && !reduceMotion) {
    const rows = [...tailDemo.querySelectorAll<HTMLElement>('[data-log]')]
    const waitUntilVisible = visibilityGate(tailDemo)
    const revealRows = () =>
      new Promise<void>(resolve => {
        let index = 0
        const tick = () => {
          const row = rows[index]
          if (!row) {
            resolve()
            return
          }
          index += 1
          row.classList.remove('opacity-0')
          setTimeout(tick, 220)
        }
        tick()
      })
    const round = async () => {
      await waitUntilVisible()
      for (const row of rows) {
        row.classList.add('opacity-0')
      }
      await sleep(500)
      await revealRows()
      await sleep(3200)
    }
    // Bounded replay (WCAG 2.2.2): stop after a few rounds instead of looping
    // forever; the resting state matches the static markup.
    let rounds = 0
    const loop = async () => {
      await round()
      rounds += 1
      if (rounds < 3) {
        loop()
      }
    }
    loop()
  }

  const filterDemo = document.querySelector('[data-filter-demo]')
  if (filterDemo && !reduceMotion) {
    const lines = [...filterDemo.querySelectorAll<HTMLElement>('[data-log]')]
    const chip = filterDemo.querySelector<HTMLElement>('[data-filter-chip]')
    const waitUntilVisible = visibilityGate(filterDemo)
    const revealLines = () =>
      new Promise<void>(resolve => {
        let index = 0
        const tick = () => {
          const line = lines[index]
          if (!line) {
            resolve()
            return
          }
          index += 1
          line.classList.remove('opacity-0')
          setTimeout(tick, 180)
        }
        tick()
      })
    const round = async () => {
      await waitUntilVisible()
      for (const line of lines) {
        line.classList.add('opacity-0')
        line.classList.remove('opacity-35')
      }
      await sleep(500)
      await revealLines()
      await sleep(800)
      chip?.classList.add('bg-signal/20')
      for (const line of lines) {
        if (line.dataset.kept === undefined) {
          line.classList.add('opacity-35')
        }
      }
      await sleep(600)
      chip?.classList.remove('bg-signal/20')
      await sleep(2800)
    }
    let rounds = 0
    const loop = async () => {
      await round()
      rounds += 1
      if (rounds < 3) {
        loop()
      }
    }
    loop()
  }

  const samplingDemo = document.querySelector('[data-sampling-demo]')
  if (samplingDemo && !reduceMotion) {
    const sampled = [
      ...samplingDemo.querySelectorAll<HTMLElement>('[data-sampled]')
    ]
    const headChip = samplingDemo.querySelector<HTMLElement>('[data-head-chip]')
    const tailChip = samplingDemo.querySelector<HTMLElement>('[data-tail-chip]')
    const waitUntilVisible = visibilityGate(samplingDemo)
    const round = async () => {
      await waitUntilVisible()
      await sleep(600)
      headChip?.classList.add('bg-signal/20')
      for (const row of sampled) {
        row.classList.add('opacity-35')
      }
      await sleep(1000)
      headChip?.classList.remove('bg-signal/20')
      await sleep(700)
      tailChip?.classList.add('bg-signal/20')
      for (const row of sampled) {
        row.classList.remove('opacity-35')
      }
      await sleep(1000)
      tailChip?.classList.remove('bg-signal/20')
      await sleep(2400)
    }
    let rounds = 0
    const loop = async () => {
      await round()
      rounds += 1
      if (rounds < 3) {
        loop()
      }
    }
    loop()
  }

  const rotation = document.querySelector('[data-rotation]')
  if (rotation && !reduceMotion) {
    const row = rotation.querySelector<HTMLElement>('[data-live-row]')
    const size = rotation.querySelector<HTMLElement>('[data-live-size]')
    const bar = rotation.querySelector<HTMLElement>('[data-live-bar]')
    const waitUntilVisible = visibilityGate(rotation)
    if (row && size && bar) {
      const growFile = () =>
        new Promise<void>(resolve => {
          let megabytes = 0.1
          const tick = () => {
            if (megabytes >= 10) {
              resolve()
              return
            }
            size.textContent = `${megabytes.toFixed(1)} MB`
            bar.style.scale = `${megabytes / 10} 1`
            megabytes += 0.3
            setTimeout(tick, 120)
          }
          tick()
        })
      const round = async () => {
        await waitUntilVisible()
        await growFile()
        size.textContent = '10.0 MB'
        bar.style.scale = '1 1'
        row.classList.add('bg-[#067647]/10', 'dark:bg-[#99ffe4]/10')
        await sleep(700)
        row.classList.remove('bg-[#067647]/10', 'dark:bg-[#99ffe4]/10')
      }
      const initialSize = size.textContent
      const initialScale = bar.style.scale
      let rounds = 0
      const loop = async () => {
        await round()
        rounds += 1
        if (rounds < 3) {
          loop()
          return
        }
        size.textContent = initialSize
        bar.style.scale = initialScale
      }
      loop()
    }
  }
</script>
