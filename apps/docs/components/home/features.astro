]

const filterRows = [
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '1ms',
    durationCls: c.mint,
    kept: false,
    method: 'GET',
    methodCls: c.mint,
    path: '/health',
    status: '200',
    statusCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 3,
    duration: '3ms',
    durationCls: c.mint,
    kept: false,
    method: 'GET',
    methodCls: c.mint,
    path: '/',
    status: '200',
    statusCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '1ms',
    durationCls: c.mint,
    kept: true,
    method: 'GET',
    methodCls: c.mint,
    path: '/favicon.ico',
    status: '404',
    statusCls: c.orange
  },
  {
    barCls: c.barMint,
    barPct: 8,
    duration: '38ms',
    durationCls: c.mint,
    kept: false,
    method: 'POST',
    methodCls: c.blue,
    path: '/auth/login',
    status: '201',
    statusCls: c.mint
  },
  {
    barCls: c.barMint,
    barPct: 2,
    duration: '2ms',
    durationCls: c.mint,
    errorRow: true,
    kept: true,
    method: 'GET',
    methodCls: c.mint,
    path: '/crash',
    status: '500',
    statusCls: c.red
