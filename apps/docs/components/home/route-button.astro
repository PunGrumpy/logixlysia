---
interface Props {
  method: string
  methodCls: string
  path: string
  route: string
}

const { method, methodCls, path, route } = Astro.props
---

<button
  aria-label={`Send ${method} ${path} request`}
  class="relative inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-md bg-panel-raised px-3 font-mono text-xs ring-1 ring-panel-border ring-inset transition-transform duration-150 ease-out-strong [-webkit-tap-highlight-color:transparent] after:absolute after:-inset-y-1 after:inset-x-0 hover:bg-panel-hover active:scale-[0.97] motion-reduce:transition-none"
  data-route={route}
  type="button"
>
  <span class:list={['font-semibold', methodCls]}>{method}</span>
  <span class="text-panel-foreground">{path}</span>
</button>
