---
import data from 'blume:data'
import PageLayout from 'blume/components/layout/PageLayout.astro'
import '../styles/home.css'

import Adapters from '../components/home/adapters.astro'
import Cta from '../components/home/cta.astro'
import Faq from '../components/home/faq.astro'
import Features from '../components/home/features.astro'
import Footer from '../components/home/footer.astro'
import Hero from '../components/home/hero.astro'
import { getLatestVersion, getReleaseUrl } from '../lib/version'

const { config } = data
const version = getLatestVersion()
const releaseUrl = getReleaseUrl(version)
const title = 'The logger for Elysia.js | Logixlysia'
const description =
  'Structured, colorful request logging for Elysia.js on Bun — filtering, sampling, enrichers, file rotation, and adapters for nine observability platforms in one plugin.'
---

<PageLayout
  analytics={config.analytics}
  appleIcon={config.appleIcon}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  ogImage="/opengraph-image.png"
  ogImageAlt="Logixlysia — the logger for Elysia.js"
  ogImageSize={{ height: 720, width: 1200 }}
  page={{
    description,
    title
  }}
  searchEnabled={config.search.enabled}
  site={{ description, title: config.title }}
  siteUrl={config.site}
  themeMode={config.theme.mode}
>
  <Hero releaseUrl={releaseUrl} version={version} />
  <Features />
  <Adapters />
  <Faq />
  <Cta />
  <Footer slot="footer" />
</PageLayout>
