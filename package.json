{
  "name": "elogs-monorepo",
  "description": "🦊 Elogs is a logger for Elysia",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bench": "turbo run bench",
    "build": "turbo run build",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "bump-ui": "cd apps/docs && bunx --bun shadcn add --all --overwrite && bunx --bun shadcn migrate --yes radix",
    "check": "ultracite check",
    "clean": " git clean -xdf .turbo node_modules",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "fix:unsafe": "ultracite fix --unsafe",
    "lint": "ultracite check",
    "prepare": "lefthook install",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "type-check": "turbo run type-check"
  },
  "resolutions": {
    "cookie": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "lefthook": "^2.1.10",
    "tsup": "^8.5.1",
    "turbo": "^2.10.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3",
    "ultracite": "7.10.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "bun",
        "version": "1.3.14",
        "onFail": "download"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  }
}
