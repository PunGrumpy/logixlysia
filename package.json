{
  "name": "logixlysia-monorepo",
  "private": true,
  "description": "🦊 Logixlysia is a logger for Elysia",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "bench": "turbo run bench",
    "build": "turbo run build",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "changeset": "changeset",
    "changeset:publish": "bun run build && changeset publish",
    "changeset:version": "changeset version",
    "clean": "git clean -xdf .turbo node_modules",
    "dev": "turbo run dev",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "exact-mirror": "^1.2.6",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.83.0",
    "turbo": "^2.11.2",
    "typescript": "6.0.3",
    "ultracite": "7.12.0"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "bun",
        "version": "1.3.14",
        "onFail": "download"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
