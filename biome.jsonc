{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/react",
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/astro",
    "ultracite/biome/vitest"
  ],
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!node_modules",
      "!.vercel",
      "!dist",
      "!**/components.d.ts",
      "!**/auto-imports.d.ts",
      "!**/volt",
      "!**/*.vue",
      "!.agents",
      "!.claude",
      "!scripts",
      "!**/scripts",
      "!**/script",
      "!apps"
    ]
  },
  "linter": {
    "rules": {
      //  性能规则
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off",
        //  正则表达式规则
        "useTopLevelRegex": "off"
      },
      "a11y": "off",
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noStaticOnlyClass": "off",
        "noForEach": "off",
        "noBannedTypes": "off"
      },
      //   可疑规则
      "suspicious": {
        "noConsole": "off",
        "noExplicitAny": "off",
        "noEvolvingTypes": "off",
        "noImplicitAnyLet": "off",
        "useIterableCallbackReturn": "off",
        "noConfusingVoidType": "off",
        "noAlert": "off",
        "noArrayIndexKey": "off"
      },
      //  新特性规则
      "nursery": {
        "noShadow": "off",
        "noIncrementDecrement": "off",
        "noSyncScripts": "off",
        "noLeakedRender": "off",
        "noUndeclaredEnvVars": "off"
      },
      "style": {
        "useDefaultParameterLast": "off",
        "noMagicNumbers": "off",
        "useFilenamingConvention": "off",
        "noNonNullAssertion": "off",
        "useBlockStatements": "off",
        "noNestedTernary": "off",
        "useConsistentTypeDefinitions": "off",
        "noParameterProperties": "off",
        "useConsistentMemberAccessibility": "off",
        "useImportType": "off",
        "useCollapsedElseIf": "off"
      },
      // 正确性规则
      "correctness": {
        "noUnusedVariables": "off",
        "noUndeclaredVariables": "off",
        "noUnknownPseudoClass": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedPrivateClassMembers": "off",
        "useImageSize": "off"
      }
    }
  },
  "files": {
    "includes": ["**/*", "!__tests__", "!**/.blume", "!**/.astro", "!**/dist"]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "assist": {
        "actions": {
          "source": {
            "useSortedProperties": "off"
          }
        }
      },
      "linter": {
        "rules": {
          "correctness": {
            "useJsxKeyInIterable": "off"
          }
        }
      }
    }
  ]
}
